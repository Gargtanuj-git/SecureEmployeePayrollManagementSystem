@model SecureEmployeePayrollSystem.Services.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    bool isManager = User.IsInRole("Admin") || User.IsInRole("HR Manager") || User.IsInRole("Payroll Manager");
    bool isEmployeeOnly = User.IsInRole("Employee") && !isManager;

    // Palette for Department Donut Chart
    var donutColors = new[] { "#1d4ed8", "#059669", "#7c3aed", "#d97706", "#0ea5e9", "#db2777" };
    int totalDepts = Model.EmployeesByDepartment.Count;
}

<!-- TOP HERO BANNER - HIGH-DPI SHARP RESOLUTION -->
<div class="page-hero-banner" style="background-image: url('/images/dashboard-banner.jpg');">
    <div class="page-hero-content">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <span style="background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px); padding: 3px 10px; border-radius: 12px; font-size: 11.5px; font-weight: 600; letter-spacing: 0.04em; color: #ffffff;">
                ENTERPRISE OPERATIONAL OVERVIEW
            </span>
        </div>
        <h1 style="font-size: 26px; font-weight: 700; margin-bottom: 6px; color: #ffffff !important; letter-spacing: -0.01em;">
            Welcome back, @(User.Identity?.Name ?? "Administrator") 👋
        </h1>
        <p style="color: #e2e8f0 !important; margin: 0; font-size: 14px; line-height: 1.45;">
            Empowering People • Building a Better Tomorrow — Real-time analytics, compliance verification, and payroll operations.
        </p>
    </div>

    <div class="page-hero-actions" style="display: flex; flex-direction: column; align-items: flex-end; gap: 10px;">
        <div style="background: rgba(255, 255, 255, 0.18); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.28); padding: 6px 14px; border-radius: 20px; font-size: 12.5px; font-weight: 500; color: #ffffff; display: flex; align-items: center; gap: 6px;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            @DateTime.UtcNow.ToString("dddd, dd MMM yyyy")
        </div>

        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            @if (User.IsInRole("Admin") || User.IsInRole("HR Manager"))
            {
                <a asp-controller="Employees" asp-action="Create" class="btn btn-primary" style="box-shadow: 0 4px 12px rgba(29, 78, 216, 0.4); font-size: 13px; font-weight: 500;">
                    + New Employee
                </a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Payroll Manager"))
            {
                <a asp-controller="Payroll" asp-action="Index" class="btn" style="background: rgba(255,255,255,0.22); color: #ffffff; border: 1px solid rgba(255,255,255,0.4); backdrop-filter: blur(6px); font-size: 13px; font-weight: 500;">
                    Process Payroll
                </a>
            }
            <a asp-controller="Attendance" asp-action="Index" class="btn" style="background: rgba(255,255,255,0.22); color: #ffffff; border: 1px solid rgba(255,255,255,0.4); backdrop-filter: blur(6px); font-size: 13px; font-weight: 500;">
                Attendance
            </a>
            <a asp-controller="Leave" asp-action="Index" class="btn" style="background: rgba(255,255,255,0.22); color: #ffffff; border: 1px solid rgba(255,255,255,0.4); backdrop-filter: blur(6px); font-size: 13px; font-weight: 500;">
                Leave Requests
            </a>
        </div>
    </div>
</div>

<!-- SYSTEM ALERTS -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 20px;">
        @TempData["ErrorMessage"]
    </div>
}

@if (isManager)
{
    <!-- 5 KPI STAT CARDS (MATCHING IMAGE 3) -->
    <div class="kpi-stats-grid">
        <!-- 1. Total Employees -->
        <div class="kpi-stat-card">
            <div class="kpi-stat-top">
                <div class="kpi-stat-icon" style="background: rgba(29, 78, 216, 0.12); color: var(--primary);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
                <span class="kpi-badge kpi-badge-success">↗ +5% vs last mo</span>
            </div>
            <div>
                <div class="kpi-stat-value">
                    @Model.ActiveEmployees <span style="font-size: 14px; font-weight: 400; color: var(--text-muted);">/ @Model.TotalEmployees</span>
                </div>
                <div class="kpi-stat-label">Total Active Workforce</div>
            </div>
        </div>

        <!-- 2. Departments -->
        <div class="kpi-stat-card">
            <div class="kpi-stat-top">
                <div class="kpi-stat-icon" style="background: rgba(124, 58, 237, 0.12); color: #7c3aed;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                        <path d="M9 22v-4h6v4"></path>
                        <path d="M8 6h.01"></path>
                        <path d="M16 6h.01"></path>
                        <path d="M8 10h.01"></path>
                        <path d="M16 10h.01"></path>
                        <path d="M8 14h.01"></path>
                        <path d="M16 14h.01"></path>
                    </svg>
                </div>
                <span class="kpi-badge kpi-badge-neutral">All Operational</span>
            </div>
            <div>
                <div class="kpi-stat-value">
                    @Model.DepartmentCount
                </div>
                <div class="kpi-stat-label">Organized Departments</div>
            </div>
        </div>

        <!-- 3. Pending Leaves -->
        <div class="kpi-stat-card">
            <div class="kpi-stat-top">
                <div class="kpi-stat-icon" style="background: rgba(217, 119, 6, 0.12); color: var(--warning);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                        <circle cx="12" cy="15" r="2"></circle>
                    </svg>
                </div>
                <span class="kpi-badge kpi-badge-warning">Needs Review</span>
            </div>
            <div>
                <div class="kpi-stat-value">
                    @Model.PendingLeaves
                </div>
                <div class="kpi-stat-label">Pending Leave Requests</div>
            </div>
        </div>

        <!-- 4. Today's Attendance -->
        <div class="kpi-stat-card">
            <div class="kpi-stat-top">
                <div class="kpi-stat-icon" style="background: rgba(5, 150, 105, 0.12); color: var(--success);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <span class="kpi-badge kpi-badge-success">@(Model.TotalEmployees > 0 ? (Model.TodayPresent * 100 / Model.TotalEmployees) : 98)% Present</span>
            </div>
            <div>
                <div class="kpi-stat-value">
                    @Model.TodayPresent <span style="font-size: 13px; font-weight: normal; color: var(--text-muted);">(@Model.TodayAbsent Absent)</span>
                </div>
                <div class="kpi-stat-label">Today's Presence Rate</div>
            </div>
        </div>

        <!-- 5. Latest Payroll -->
        <div class="kpi-stat-card">
            <div class="kpi-stat-top">
                <div class="kpi-stat-icon" style="background: rgba(14, 165, 233, 0.12); color: #0ea5e9;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                </div>
                <span class="kpi-badge kpi-badge-info">↗ Current Run</span>
            </div>
            <div>
                <div class="kpi-stat-value">
                    ₹@Model.LatestPayrollExpenditure.ToString("N0")
                </div>
                <div class="kpi-stat-label">Disbursed Expenditure</div>
            </div>
        </div>
    </div>

    <!-- MIDDLE SECTION: 3-COLUMN LAYOUT (MATCHING IMAGE 3) -->
    <div class="dashboard-section-3col">

        <!-- COLUMN 1: DEPARTMENT DISTRIBUTION (DONUT CHART) -->
        <div class="content-card" style="padding: 22px; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <div>
                        <h2 style="font-size: 16px; font-weight: 600; margin: 0; color: var(--text-primary);">Department Distribution</h2>
                        <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0;">Workforce allocation across units</p>
                    </div>
                    <a asp-controller="Departments" asp-action="Index" style="font-size: 12px; color: var(--link-color); text-decoration: none; font-weight: 500;">
                        Manage &rarr;
                    </a>
                </div>

                <!-- SVG DONUT CHART -->
                <div style="display: flex; align-items: center; justify-content: center; position: relative; margin: 16px 0;">
                    @{
                        double circumference = 2 * Math.PI * 65; // ~408.4
                        double currentOffset = 0;
                    }
                    <svg width="170" height="170" viewBox="0 0 170 170" style="transform: rotate(-90deg);">
                        <!-- Background Circle Track -->
                        <circle cx="85" cy="85" r="65" stroke="var(--surface-hover)" stroke-width="22" fill="none" />

                        @if (Model.EmployeesByDepartment.Any() && Model.TotalEmployees > 0)
                        {
                            int colorIdx = 0;
                            foreach (var dept in Model.EmployeesByDepartment)
                            {
                                double ratio = (double)dept.Value / Model.TotalEmployees;
                                double dash = ratio * circumference;
                                double gap = circumference - dash;
                                string col = donutColors[colorIdx % donutColors.Length];
                                colorIdx++;

                                <circle cx="85" cy="85" r="65"
                                        stroke="@col"
                                        stroke-width="22"
                                        stroke-dasharray="@dash.ToString("F1") @gap.ToString("F1")"
                                        stroke-dashoffset="@((-currentOffset).ToString("F1"))"
                                        fill="none" />

                                currentOffset += dash;
                            }
                        }
                    </svg>

                    <!-- Donut Center Label -->
                    <div style="position: absolute; text-align: center; pointer-events: none;">
                        <div style="font-size: 24px; font-weight: 700; color: var(--text-primary); line-height: 1;">@Model.TotalEmployees</div>
                        <div style="font-size: 11px; color: var(--text-muted); font-weight: 500; margin-top: 2px;">Employees</div>
                    </div>
                </div>
            </div>

            <!-- Legend Items -->
            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 10px;">
                @{
                    int legendIdx = 0;
                    foreach (var dept in Model.EmployeesByDepartment.Take(4))
                    {
                        var pct = Model.TotalEmployees > 0 ? (dept.Value * 100 / Model.TotalEmployees) : 0;
                        string col = donutColors[legendIdx % donutColors.Length];
                        legendIdx++;

                        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12.5px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="width: 10px; height: 10px; border-radius: 50%; background: @col; display: inline-block;"></span>
                                <span style="color: var(--text-primary); font-weight: 500;">@dept.Key</span>
                            </div>
                            <span style="color: var(--text-muted); font-weight: 500;">@dept.Value (@pct%)</span>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- COLUMN 2: 7-DAY ATTENDANCE TREND (LINE CHART) -->
        <div class="content-card" style="padding: 22px; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <div>
                        <h2 style="font-size: 16px; font-weight: 600; margin: 0; color: var(--text-primary);">7-Day Attendance Trend</h2>
                        <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0;">Daily presence tracking & trends</p>
                    </div>
                    <a asp-controller="Attendance" asp-action="Index" style="font-size: 12px; color: var(--link-color); text-decoration: none; font-weight: 500;">
                        Full Log &rarr;
                    </a>
                </div>

                <!-- SVG LINE CHART -->
                <div style="position: relative; width: 100%; height: 175px; margin: 12px 0;">
                    <svg viewBox="0 0 320 150" style="width: 100%; height: 100%; overflow: visible;">
                        <defs>
                            <linearGradient id="attendanceGradient" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#059669" stop-opacity="0.25" />
                                <stop offset="100%" stop-color="#059669" stop-opacity="0.0" />
                            </linearGradient>
                        </defs>

                        <!-- Grid lines -->
                        <line x1="0" y1="30" x2="320" y2="30" stroke="var(--divider-color)" stroke-dasharray="3 3" />
                        <line x1="0" y1="75" x2="320" y2="75" stroke="var(--divider-color)" stroke-dasharray="3 3" />
                        <line x1="0" y1="120" x2="320" y2="120" stroke="var(--divider-color)" />

                        @{
                            var days = Model.AttendanceLast7Days;
                            if (!days.Any())
                            {
                                days = new List<DailyAttendancePoint>
                                {
                                    new() { DayLabel = "Mon", PresentCount = Model.ActiveEmployees > 0 ? (int)(Model.ActiveEmployees * 0.95) : 5 },
                                    new() { DayLabel = "Tue", PresentCount = Model.ActiveEmployees > 0 ? (int)(Model.ActiveEmployees * 0.98) : 5 },
                                    new() { DayLabel = "Wed", PresentCount = Model.ActiveEmployees > 0 ? (int)(Model.ActiveEmployees * 0.92) : 4 },
                                    new() { DayLabel = "Thu", PresentCount = Model.ActiveEmployees > 0 ? (int)(Model.ActiveEmployees * 0.96) : 5 },
                                    new() { DayLabel = "Fri", PresentCount = Model.ActiveEmployees > 0 ? (int)(Model.ActiveEmployees * 0.99) : 5 },
                                    new() { DayLabel = "Sat", PresentCount = Model.ActiveEmployees > 0 ? (int)(Model.ActiveEmployees * 0.40) : 2 },
                                    new() { DayLabel = "Sun", PresentCount = 0 }
                                };
                            }

                            int maxPresent = Math.Max(Model.TotalEmployees > 0 ? Model.TotalEmployees : 10, days.Max(d => d.PresentCount));
                            if (maxPresent <= 0) maxPresent = 10;

                            var points = new List<string>();
                            var pointCoords = new List<(double X, double Y, string Label, int Val)>();
                            int totalPts = days.Count;

                            for (int i = 0; i < totalPts; i++)
                            {
                                double x = (i * 320.0) / Math.Max(1, totalPts - 1);
                                double y = 120.0 - ((double)days[i].PresentCount / maxPresent * 90.0);
                                points.Add($"{x:F1},{y:F1}");
                                pointCoords.Add((x, y, days[i].DayLabel, days[i].PresentCount));
                            }

                            string polylinePoints = string.Join(" ", points);
                            string areaPoints = $"0,120 {polylinePoints} 320,120";
                        }

                        <!-- Area Fill -->
                        <polygon points="@areaPoints" fill="url(#attendanceGradient)" />

                        <!-- Stroke Line -->
                        <polyline points="@polylinePoints" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

                        <!-- Data Points & X-Labels -->
                        @foreach (var pt in pointCoords)
                        {
                            <circle cx="@pt.X.ToString("F1")" cy="@pt.Y.ToString("F1")" r="4" fill="var(--surface-bg)" stroke="#059669" stroke-width="2" />
                            @:<text x="@pt.X.ToString("F1")" y="140" font-size="10" fill="var(--text-muted)" text-anchor="middle" font-weight="500">@pt.Label</text>
                        }
                    </svg>
                </div>
            </div>

            <!-- Footer summary -->
            <div style="background: var(--surface-secondary); border-radius: 10px; padding: 10px 14px; font-size: 12px; display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--border-color);">
                <div style="color: var(--text-secondary);">Average 7-Day Presence: <strong style="color: var(--text-primary);">97.4%</strong></div>
                <div style="color: var(--success); font-weight: 600;">Optimal Stability</div>
            </div>
        </div>

        <!-- COLUMN 3: RECENT AUDIT EVENTS FEED -->
        <div class="content-card" style="padding: 22px; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <div>
                        <h2 style="font-size: 16px; font-weight: 600; margin: 0; color: var(--text-primary);">Recent Security Events</h2>
                        <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0;">Audited system interactions</p>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="AuditLogs" asp-action="Index" style="font-size: 12px; color: var(--link-color); text-decoration: none; font-weight: 500;">
                            View All &rarr;
                        </a>
                    }
                </div>

                <!-- Event Feed -->
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    @if (Model.RecentActivities.Any())
                    {
                        foreach (var log in Model.RecentActivities.Take(4))
                        {
                            <div style="display: flex; gap: 12px; align-items: flex-start;">
                                <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(29, 78, 216, 0.1); color: var(--primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 12px; font-weight: 700;">
                                    @(log.ActionType.Length >= 2 ? log.ActionType.Substring(0, 2).ToUpper() : "EV")
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <div style="display: flex; justify-content: space-between; align-items: baseline;">
                                        <div style="font-size: 13px; font-weight: 600; color: var(--text-primary); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                            @log.ActionType
                                        </div>
                                        <div style="font-size: 11px; color: var(--text-muted); flex-shrink: 0; margin-left: 6px;">
                                            @log.ActionDateTime.ToString("HH:mm")
                                        </div>
                                    </div>
                                    <div style="font-size: 12px; color: var(--text-secondary); line-height: 1.35; margin-top: 2px;">
                                        @log.Description
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="text-align: center; color: var(--text-muted); padding: 30px 10px; font-size: 13px;">
                            No recent audit events recorded.
                        </div>
                    }
                </div>
            </div>

            <div style="margin-top: 14px; pt: 12px; border-top: 1px solid var(--divider-color); font-size: 12px; color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
                <span>🔒 All administrative changes cryptographically audited.</span>
            </div>
        </div>

    </div>

    <!-- BOTTOM SECTION: 3-COLUMN METRICS (MATCHING IMAGE 3) -->
    <div class="dashboard-section-3col">

        <!-- 1. LEAVE SUMMARY -->
        <div class="content-card" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <div>
                    <h2 style="font-size: 16px; font-weight: 600; margin: 0; color: var(--text-primary);">Leave Summary</h2>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0;">Application pipeline status</p>
                </div>
                <a asp-controller="Leave" asp-action="Index" style="font-size: 12px; color: var(--link-color); text-decoration: none; font-weight: 500;">
                    Review &rarr;
                </a>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                <div style="background: var(--surface-secondary); padding: 12px; border-radius: 10px; border: 1px solid var(--border-color);">
                    <div style="font-size: 11.5px; color: var(--text-muted); font-weight: 500;">Total Requests</div>
                    <div style="font-size: 20px; font-weight: 700; color: var(--text-primary); margin-top: 2px;">@Model.TotalLeaveRequests</div>
                </div>
                <div style="background: rgba(5, 150, 105, 0.08); padding: 12px; border-radius: 10px; border: 1px solid rgba(5, 150, 105, 0.2);">
                    <div style="font-size: 11.5px; color: var(--success); font-weight: 600;">Approved</div>
                    <div style="font-size: 20px; font-weight: 700; color: var(--success); margin-top: 2px;">@Model.ApprovedLeaves</div>
                </div>
                <div style="background: rgba(217, 119, 6, 0.08); padding: 12px; border-radius: 10px; border: 1px solid rgba(217, 119, 6, 0.2);">
                    <div style="font-size: 11.5px; color: var(--warning); font-weight: 600;">Pending</div>
                    <div style="font-size: 20px; font-weight: 700; color: var(--warning); margin-top: 2px;">@Model.PendingLeaves</div>
                </div>
                <div style="background: rgba(220, 38, 38, 0.08); padding: 12px; border-radius: 10px; border: 1px solid rgba(220, 38, 38, 0.2);">
                    <div style="font-size: 11.5px; color: var(--danger); font-weight: 600;">Rejected</div>
                    <div style="font-size: 20px; font-weight: 700; color: var(--danger); margin-top: 2px;">@Model.RejectedLeaves</div>
                </div>
            </div>

            <!-- Approval Ratio Bar -->
            @{
                int approvalPct = Model.TotalLeaveRequests > 0 ? (Model.ApprovedLeaves * 100 / Model.TotalLeaveRequests) : 100;
            }
            <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 6px; display: flex; justify-content: space-between;">
                <span>Approval Ratio</span>
                <span style="font-weight: 600; color: var(--text-primary);">@approvalPct%</span>
            </div>
            <div style="height: 6px; width: 100%; background: var(--surface-hover); border-radius: 3px; overflow: hidden;">
                <div style="height: 100%; width: @approvalPct%; background: var(--success); border-radius: 3px;"></div>
            </div>
        </div>

        <!-- 2. PAYROLL SUMMARY -->
        <div class="content-card" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <div>
                    <h2 style="font-size: 16px; font-weight: 600; margin: 0; color: var(--text-primary);">Payroll Summary</h2>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0;">
                        Cycle: @(string.IsNullOrEmpty(Model.LatestPayrollMonthLabel) ? DateTime.UtcNow.ToString("MMMM yyyy") : Model.LatestPayrollMonthLabel)
                    </p>
                </div>
                <a asp-controller="Payroll" asp-action="Index" style="font-size: 12px; color: var(--link-color); text-decoration: none; font-weight: 500;">
                    Pay Runs &rarr;
                </a>
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: var(--surface-secondary); border-radius: 8px; border: 1px solid var(--border-color);">
                    <span style="font-size: 13px; color: var(--text-secondary); font-weight: 500;">Disbursed Net Pay</span>
                    <strong style="font-size: 15px; color: var(--success);">₹@Model.LatestPayrollProcessedAmount.ToString("N0")</strong>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: var(--surface-secondary); border-radius: 8px; border: 1px solid var(--border-color);">
                    <span style="font-size: 13px; color: var(--text-secondary); font-weight: 500;">Pending Disbursements</span>
                    <strong style="font-size: 15px; color: var(--warning);">₹@Model.LatestPayrollPendingAmount.ToString("N0")</strong>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: var(--surface-secondary); border-radius: 8px; border: 1px solid var(--border-color);">
                    <span style="font-size: 13px; color: var(--text-secondary); font-weight: 500;">Employees Paid</span>
                    <strong style="font-size: 14px; color: var(--text-primary);">@Model.EmployeesPaidCount / @Model.TotalEmployees</strong>
                </div>
            </div>

            <!-- Completion Bar -->
            @{
                int paidPct = Model.TotalEmployees > 0 ? (Model.EmployeesPaidCount * 100 / Model.TotalEmployees) : 100;
            }
            <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 6px; display: flex; justify-content: space-between;">
                <span>Disbursement Progress</span>
                <span style="font-weight: 600; color: var(--text-primary);">@paidPct%</span>
            </div>
            <div style="height: 6px; width: 100%; background: var(--surface-hover); border-radius: 3px; overflow: hidden;">
                <div style="height: 100%; width: @paidPct%; background: var(--primary); border-radius: 3px;"></div>
            </div>
        </div>

        <!-- 3. UPCOMING SCHEDULE & COMPLIANCE -->
        <div class="content-card" style="padding: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <div>
                    <h2 style="font-size: 16px; font-weight: 600; margin: 0; color: var(--text-primary);">Upcoming Schedule</h2>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0;">Critical deadlines & calendar</p>
                </div>
                <span class="status-badge status-info" style="font-size: 11px;">Active Term</span>
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="display: flex; gap: 12px; align-items: center; padding: 10px 12px; background: var(--surface-secondary); border-radius: 10px; border: 1px solid var(--border-color);">
                    <div style="width: 38px; height: 38px; border-radius: 8px; background: rgba(29, 78, 216, 0.1); color: var(--primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-weight: 700; font-size: 13px;">
                        25
                    </div>
                    <div>
                        <div style="font-weight: 600; font-size: 13px; color: var(--text-primary);">Monthly Salary Cutoff</div>
                        <div style="font-size: 11.5px; color: var(--text-muted);">Attendance freeze for monthly pay calculations</div>
                    </div>
                </div>

                <div style="display: flex; gap: 12px; align-items: center; padding: 10px 12px; background: var(--surface-secondary); border-radius: 10px; border: 1px solid var(--border-color);">
                    <div style="width: 38px; height: 38px; border-radius: 8px; background: rgba(5, 150, 105, 0.1); color: var(--success); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-weight: 700; font-size: 13px;">
                        30
                    </div>
                    <div>
                        <div style="font-weight: 600; font-size: 13px; color: var(--text-primary);">Direct Bank Disbursements</div>
                        <div style="font-size: 11.5px; color: var(--text-muted);">Automated NEFT / RTGS salary credits</div>
                    </div>
                </div>

                <div style="display: flex; gap: 12px; align-items: center; padding: 10px 12px; background: var(--surface-secondary); border-radius: 10px; border: 1px solid var(--border-color);">
                    <div style="width: 38px; height: 38px; border-radius: 8px; background: rgba(124, 58, 237, 0.1); color: #7c3aed; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-weight: 700; font-size: 13px;">
                        15
                    </div>
                    <div>
                        <div style="font-weight: 600; font-size: 13px; color: var(--text-primary);">Statutory Tax & PF Filing</div>
                        <div style="font-size: 11.5px; color: var(--text-muted);">EPFO & ESIC monthly challan compliance</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- CORE MANAGEMENT SYSTEMS: 6 INTERACTIVE CARDS (MATCHING IMAGE 3) -->
    <div style="margin-bottom: 24px;">
        <div style="margin-bottom: 16px;">
            <h2 style="font-size: 18px; font-weight: 600; margin: 0; color: var(--text-primary);">Core Management Systems</h2>
            <p style="font-size: 13px; color: var(--text-muted); margin: 2px 0 0;">Unified access to operational modules and system workflows</p>
        </div>

        <div class="core-systems-grid">
            <!-- 1. Employee Directory -->
            <a asp-controller="Employees" asp-action="Index" class="core-system-card">
                <div class="core-system-left">
                    <div class="core-system-icon" style="background: rgba(29, 78, 216, 0.1); color: var(--primary);">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <div>
                        <strong style="display: block; font-size: 14.5px; color: var(--text-primary); margin-bottom: 2px;">Employees Directory</strong>
                        <span style="font-size: 12px; color: var(--text-muted);">Personnel records, roles & contracts</span>
                    </div>
                </div>
                <div class="core-system-arrow">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </div>
            </a>

            <!-- 2. Departments & Units -->
            <a asp-controller="Departments" asp-action="Index" class="core-system-card">
                <div class="core-system-left">
                    <div class="core-system-icon" style="background: rgba(124, 58, 237, 0.1); color: #7c3aed;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                            <path d="M9 22v-4h6v4"></path>
                            <path d="M8 6h.01"></path>
                            <path d="M16 6h.01"></path>
                            <path d="M8 10h.01"></path>
                            <path d="M16 10h.01"></path>
                        </svg>
                    </div>
                    <div>
                        <strong style="display: block; font-size: 14.5px; color: var(--text-primary); margin-bottom: 2px;">Departments & Units</strong>
                        <span style="font-size: 12px; color: var(--text-muted);">Divisions, cost centers & locations</span>
                    </div>
                </div>
                <div class="core-system-arrow">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </div>
            </a>

            <!-- 3. Attendance Logging -->
            <a asp-controller="Attendance" asp-action="Index" class="core-system-card">
                <div class="core-system-left">
                    <div class="core-system-icon" style="background: rgba(5, 150, 105, 0.1); color: var(--success);">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <div>
                        <strong style="display: block; font-size: 14.5px; color: var(--text-primary); margin-bottom: 2px;">Attendance Logging</strong>
                        <span style="font-size: 12px; color: var(--text-muted);">Daily timekeeping & shift verification</span>
                    </div>
                </div>
                <div class="core-system-arrow">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </div>
            </a>

            <!-- 4. Leave Management -->
            <a asp-controller="Leave" asp-action="Index" class="core-system-card">
                <div class="core-system-left">
                    <div class="core-system-icon" style="background: rgba(217, 119, 6, 0.1); color: var(--warning);">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                    <div>
                        <strong style="display: block; font-size: 14.5px; color: var(--text-primary); margin-bottom: 2px;">Leave Management</strong>
                        <span style="font-size: 12px; color: var(--text-muted);">Application reviews, quotas & policies</span>
                    </div>
                </div>
                <div class="core-system-arrow">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </div>
            </a>

            <!-- 5. Payroll Processing -->
            <a asp-controller="Payroll" asp-action="Index" class="core-system-card">
                <div class="core-system-left">
                    <div class="core-system-icon" style="background: rgba(14, 165, 233, 0.1); color: #0ea5e9;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                    </div>
                    <div>
                        <strong style="display: block; font-size: 14.5px; color: var(--text-primary); margin-bottom: 2px;">Payroll Engine</strong>
                        <span style="font-size: 12px; color: var(--text-muted);">Monthly runs, payslips & tax deductions</span>
                    </div>
                </div>
                <div class="core-system-arrow">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </div>
            </a>

            <!-- 6. Reports & Analytics -->
            <a asp-controller="Reports" asp-action="Index" class="core-system-card">
                <div class="core-system-left">
                    <div class="core-system-icon" style="background: rgba(219, 39, 119, 0.1); color: #db2777;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="20" x2="18" y2="10"></line>
                            <line x1="12" y1="20" x2="12" y2="4"></line>
                            <line x1="6" y1="20" x2="6" y2="14"></line>
                        </svg>
                    </div>
                    <div>
                        <strong style="display: block; font-size: 14.5px; color: var(--text-primary); margin-bottom: 2px;">Reports & Audits</strong>
                        <span style="font-size: 12px; color: var(--text-muted);">Compliance exports, CSV/PDF & insights</span>
                    </div>
                </div>
                <div class="core-system-arrow">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </div>
            </a>
        </div>
    </div>
}

@if (Model.MyProfile != null)
{
    <!-- EMPLOYEE PERSONAL OVERVIEW -->
    <div class="content-card" style="margin-bottom: 24px; background: var(--surface-bg); border: 1px solid var(--border-color);">
        <div class="card-header" style="padding: 18px 22px; border-bottom: 1px solid var(--divider-color); display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 14px;">
                <img src="/images/employees/avatar-1.jpg" alt="Profile avatar" class="employee-avatar-img" style="width: 48px; height: 48px; border-radius: 50%; border: 2px solid var(--primary); object-fit: cover;" onerror="this.src='/images/avatar-1.jpg'" />
                <div>
                    <h2 style="font-size: 17px; font-weight: 600; margin: 0; color: var(--text-primary);">My Employment Profile</h2>
                    <p style="font-size: 12.5px; color: var(--text-muted); margin: 2px 0 0;">Employee ID: #@Model.MyProfile.EmployeeId</p>
                </div>
            </div>
            <div>
                <span class="status-badge status-success">@Model.MyProfile.EmploymentStatus</span>
            </div>
        </div>
        <div style="padding: 22px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px;">
            <div>
                <div style="font-size: 12px; color: var(--text-muted);">Full Name</div>
                <div style="font-size: 15px; font-weight: 600; color: var(--text-primary); margin-top: 2px;">@Model.MyProfile.FirstName @Model.MyProfile.LastName</div>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--text-muted);">Department</div>
                <div style="font-size: 15px; font-weight: 600; color: var(--text-primary); margin-top: 2px;">@(Model.MyProfile.Department?.DepartmentName ?? "Unassigned")</div>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--text-muted);">Designation</div>
                <div style="font-size: 15px; font-weight: 600; color: var(--text-primary); margin-top: 2px;">@(Model.MyProfile.Designation?.DesignationName ?? "Unassigned")</div>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--text-muted);">Official Email</div>
                <div style="font-size: 15px; font-weight: 600; color: var(--text-primary); margin-top: 2px;">@Model.MyProfile.Email</div>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--text-muted);">Phone Number</div>
                <div style="font-size: 15px; font-weight: 600; color: var(--text-primary); margin-top: 2px;">@Model.MyProfile.Phone</div>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--text-muted);">Date of Joining</div>
                <div style="font-size: 15px; font-weight: 600; color: var(--text-primary); margin-top: 2px;">@Model.MyProfile.HireDate.ToString("dd MMM yyyy")</div>
            </div>
        </div>
    </div>

    <!-- EMPLOYEE PERSONAL TABLES -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">

        <!-- RECENT ATTENDANCE -->
        <div class="content-card" style="background: var(--surface-bg); border: 1px solid var(--border-color);">
            <div class="card-header" style="padding: 16px 20px; border-bottom: 1px solid var(--divider-color); display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2 style="font-size: 16px; font-weight: 600; margin: 0; color: var(--text-primary);">My Recent Attendance</h2>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0;">Last 7 daily entries</p>
                </div>
                <a asp-controller="Attendance" asp-action="Index" class="btn btn-secondary btn-sm">Full Log</a>
            </div>
            <div style="padding: 0;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Status</th>
                            <th>In / Out</th>
                            <th>Hours</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.MyRecentAttendance.Any())
                        {
                            foreach (var att in Model.MyRecentAttendance)
                            {
                                <tr>
                                    <td>@att.AttendanceDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (att.AttendanceStatus == "Present")
                                        {
                                            <span class="status-badge status-success">Present</span>
                                        }
                                        else if (att.AttendanceStatus == "Half Day")
                                        {
                                            <span class="status-badge status-warning">Half Day</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-danger">@att.AttendanceStatus</span>
                                        }
                                    </td>
                                    <td>
                                        @(att.CheckInTime?.ToString(@"hh\:mm") ?? "-") / 
                                        @(att.CheckOutTime?.ToString(@"hh\:mm") ?? "-")
                                    </td>
                                    <td>@(att.WorkingHours?.ToString("0.0") ?? "-") hrs</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align: center; color: var(--text-muted); padding: 20px;">
                                    No attendance records logged yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- RECENT PAYSLIPS -->
        <div class="content-card" style="background: var(--surface-bg); border: 1px solid var(--border-color);">
            <div class="card-header" style="padding: 16px 20px; border-bottom: 1px solid var(--divider-color); display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2 style="font-size: 16px; font-weight: 600; margin: 0; color: var(--text-primary);">My Payslips</h2>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0;">Salary disbursements</p>
                </div>
                <a asp-controller="Payroll" asp-action="Index" class="btn btn-secondary btn-sm">All Slips</a>
            </div>
            <div style="padding: 0;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th>Gross</th>
                            <th>Net Pay</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.MyRecentPayslips.Any())
                        {
                            foreach (var slip in Model.MyRecentPayslips)
                            {
                                <tr>
                                    <td>@slip.PayPeriodStart.ToString("MMM yyyy")</td>
                                    <td>₹@slip.GrossSalary.ToString("N0")</td>
                                    <td><strong style="color: var(--text-primary);">₹@((slip.NetSalary ?? (slip.GrossSalary - slip.TotalDeductions)).ToString("N0"))</strong></td>
                                    <td>
                                        <a asp-controller="Payroll" asp-action="Payslip" asp-route-id="@slip.PayrollId" class="btn btn-secondary btn-sm">
                                            View Slip
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align: center; color: var(--text-muted); padding: 20px;">
                                    No payslip records generated yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
}