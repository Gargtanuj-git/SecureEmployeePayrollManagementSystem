@model EmployeeFormViewModel

@{
    ViewData["Title"] = "Add Employee";
}

<div class="page-header">
    <div>
        <h1>Add New Employee</h1>
        <p>Register a new employee profile and assign them to an organizational department and salary grade.</p>
    </div>
    <div class="page-header-actions">
        <a asp-controller="Employees" asp-action="Index" class="btn btn-secondary">
            &larr; Back to Directory
        </a>
    </div>
</div>

<div class="content-card">
    <div class="card-header">
        <div>
            <h2>Employee Information</h2>
            <p>All fields marked with an asterisk (*) are mandatory.</p>
        </div>
    </div>

    <form asp-controller="Employees" asp-action="Create" method="post" style="padding: 24px;">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <h3 style="font-size: 15px; font-weight: 600; margin: 0 0 16px; color: var(--seps-primary);">Personal Details</h3>
        
        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
            <div class="form-group">
                <label asp-for="FirstName">First Name *</label>
                <input asp-for="FirstName" class="form-control" placeholder="e.g. Rahul" />
                <span asp-validation-for="FirstName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="LastName">Last Name *</label>
                <input asp-for="LastName" class="form-control" placeholder="e.g. Sharma" />
                <span asp-validation-for="LastName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="DateOfBirth">Date of Birth *</label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
                <span asp-validation-for="DateOfBirth" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Gender">Gender *</label>
                <select asp-for="Gender" class="form-control">
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="Gender" class="field-validation-error"></span>
            </div>
        </div>

        <h3 style="font-size: 15px; font-weight: 600; margin: 0 0 16px; color: var(--seps-primary);">Contact Information</h3>

        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
            <div class="form-group">
                <label asp-for="Email">Official Email *</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="e.g. rahul.sharma@company.com" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone">Phone Number *</label>
                <input asp-for="Phone" type="tel" class="form-control" placeholder="e.g. +91 9876543210" />
                <span asp-validation-for="Phone" class="field-validation-error"></span>
            </div>

            <div class="form-group" style="grid-column: span 2;">
                <label asp-for="Address">Residential Address *</label>
                <input asp-for="Address" class="form-control" placeholder="e.g. Flat 402, Green Valley Apartments, New Delhi" />
                <span asp-validation-for="Address" class="field-validation-error"></span>
            </div>
        </div>

        <h3 style="font-size: 15px; font-weight: 600; margin: 0 0 16px; color: var(--seps-primary);">Employment & Compensation</h3>

        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
            <div class="form-group">
                <label asp-for="HireDate">Hire Date *</label>
                <input asp-for="HireDate" type="date" class="form-control" />
                <span asp-validation-for="HireDate" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="EmploymentStatus">Employment Status *</label>
                <select asp-for="EmploymentStatus" class="form-control">
                    <option value="Active">Active</option>
                    <option value="On Leave">On Leave</option>
                    <option value="Inactive">Inactive</option>
                </select>
                <span asp-validation-for="EmploymentStatus" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="DepartmentId">Department *</label>
                <select asp-for="DepartmentId" asp-items="Model.DepartmentOptions" class="form-control">
                    <option value="">-- Select Department --</option>
                </select>
                <span asp-validation-for="DepartmentId" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="DesignationId">Designation *</label>
                <select asp-for="DesignationId" asp-items="Model.DesignationOptions" class="form-control">
                    <option value="">-- Select Designation --</option>
                </select>
                <span asp-validation-for="DesignationId" class="field-validation-error"></span>
            </div>

            <div class="form-group" style="grid-column: span 2;">
                <label asp-for="SalaryStructureId">Salary Grade / Pay Scale *</label>
                <select asp-for="SalaryStructureId" asp-items="Model.SalaryStructureOptions" class="form-control">
                    <option value="">-- Select Grade Level --</option>
                </select>
                <span asp-validation-for="SalaryStructureId" class="field-validation-error"></span>
            </div>
        </div>

        <div class="form-actions" style="display: flex; gap: 12px; justify-content: flex-end; padding-top: 16px; border-top: 1px solid var(--seps-border);">
            <a asp-controller="Employees" asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Create Employee Record</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
