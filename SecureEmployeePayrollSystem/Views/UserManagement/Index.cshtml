@model IEnumerable<SecureEmployeePayrollSystem.Models.UserAccount>

@{
    ViewData["Title"] = "User Accounts";
    var roles = (List<AppRole>)ViewBag.Roles;
    int currentPage = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
}

<div class="page-hero-banner" style="background-image: url('/images/reports-banner.jpg');">
    <div class="page-hero-content">
        <h1 style="font-size: 26px; font-weight: 600; margin-bottom: 6px; color: #ffffff !important;">
            User Account Administration
        </h1>
        <p style="color: #e2e8f0 !important; margin: 0; font-size: 14px;">
            Manage system identities, RBAC role mappings, brute-force lockouts, and security credentials.
        </p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="content-card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h2>User Account Directory</h2>
            <p>Showing @Model.Count() accounts (Total registered: @ViewBag.TotalCount)</p>
        </div>
        <a asp-action="Create" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 500;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Create User
        </a>
    </div>

    <!-- FILTER BAR -->
    <form asp-controller="UserManagement" asp-action="Index" method="get" class="filter-bar">
        <div class="form-group" style="flex: 2;">
            <label for="search">Search</label>
            <input type="text" id="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by username or linked employee name..." />
        </div>

        <div class="form-group" style="flex: 1;">
            <label for="roleId">Role</label>
            <select id="roleId" name="roleId" class="form-control filter-select">
                <option value="">All Roles</option>
                @foreach (var r in roles)
                {
                    <option value="@r.RoleId" selected="@(ViewBag.RoleId == r.RoleId ? "selected" : null)">
                        @r.RoleName
                    </option>
                }
            </select>
        </div>

        <div class="form-group" style="flex: 1;">
            <label for="status">Account Status</label>
            <select id="status" name="status" class="form-control filter-select">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(ViewBag.Status == "Active" ? "selected" : null)">Active</option>
                <option value="Locked" selected="@(ViewBag.Status == "Locked" ? "selected" : null)">Locked (Brute Force)</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive" ? "selected" : null)">Inactive</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary" style="margin-bottom: 2px;">Filter</button>
        <a asp-controller="UserManagement" asp-action="Index" class="btn btn-secondary" style="margin-bottom: 2px;">Reset</a>
    </form>

    <!-- TABLE -->
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Linked Employee</th>
                    <th>Assigned Roles</th>
                    <th>Failed Logins</th>
                    <th>Status</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var u in Model)
                    {
                        <tr>
                            <td><strong>#@u.UserId</strong></td>
                            <td>
                                <a asp-controller="UserManagement" asp-action="Details" asp-route-id="@u.UserId" style="font-weight: 500; color: var(--primary); text-decoration: none;">
                                    @u.Username
                                </a>
                            </td>
                            <td>
                                @if (u.Employee != null)
                                {
                                    <div>@u.Employee.FirstName @u.Employee.LastName</div>
                                    <div style="font-size: 12px; color: var(--text-secondary);">@(u.Employee.Department?.DepartmentName ?? "N/A")</div>
                                }
                                else
                                {
                                    <span style="color: var(--text-secondary);">No Employee Linked</span>
                                }
                            </td>
                            <td>
                                @foreach (var ur in u.UserRoleUsers)
                                {
                                    <span class="status-badge status-neutral" style="margin-right: 4px;">
                                        @ur.Role.RoleName
                                    </span>
                                }
                            </td>
                            <td>
                                @if (u.FailedLoginAttempts > 0)
                                {
                                    <strong style="color: var(--google-red);">@u.FailedLoginAttempts attempt(s)</strong>
                                }
                                else
                                {
                                    <span>0</span>
                                }
                            </td>
                            <td>
                                @if (u.AccountStatus == "Active")
                                {
                                    <span class="status-badge status-success">Active</span>
                                }
                                else if (u.AccountStatus == "Locked")
                                {
                                    <span class="status-badge status-danger">Locked</span>
                                }
                                else
                                {
                                    <span class="status-badge status-neutral">@u.AccountStatus</span>
                                }
                            </td>
                            <td style="text-align: right; white-space: nowrap;">
                                <a asp-controller="UserManagement" asp-action="Details" asp-route-id="@u.UserId" class="btn btn-secondary btn-sm">
                                    Manage
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <h3>No users found</h3>
                                <p>No user accounts match your filter criteria.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION -->
    @if (totalPages > 1)
    {
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-top: 1px solid var(--border-color);">
            <div style="font-size: 13px; color: var(--text-secondary);">
                Page @currentPage of @totalPages
            </div>
            <div style="display: flex; gap: 6px;">
                @if (currentPage > 1)
                {
                    <a asp-controller="UserManagement" asp-action="Index" 
                       asp-route-page="@(currentPage - 1)" 
                       asp-route-search="@ViewBag.Search" 
                       asp-route-roleId="@ViewBag.RoleId" 
                       asp-route-status="@ViewBag.Status" 
                       class="btn btn-secondary btn-sm">&larr; Previous</a>
                }
                @if (currentPage < totalPages)
                {
                    <a asp-controller="UserManagement" asp-action="Index" 
                       asp-route-page="@(currentPage + 1)" 
                       asp-route-search="@ViewBag.Search" 
                       asp-route-roleId="@ViewBag.RoleId" 
                       asp-route-status="@ViewBag.Status" 
                       class="btn btn-secondary btn-sm">Next &rarr;</a>
                }
            </div>
        </div>
    }
</div>
