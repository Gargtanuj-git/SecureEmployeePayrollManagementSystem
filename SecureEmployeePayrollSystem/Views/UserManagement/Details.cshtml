@model SecureEmployeePayrollSystem.Models.UserAccount

@{
    ViewData["Title"] = $"User #{Model.UserId} - {Model.Username}";
    var allRoles = (List<AppRole>)ViewBag.AllRoles;
}

<div class="page-header">
    <div>
        <h1>User Account: @Model.Username</h1>
        <p>User ID: #@Model.UserId | Status: @Model.AccountStatus | Linked Employee: @(Model.Employee != null ? $"{Model.Employee.FirstName} {Model.Employee.LastName} (#{Model.EmployeeId})" : "None")</p>
    </div>
    <div class="page-header-actions" style="display: flex; gap: 8px;">
        <a asp-controller="UserManagement" asp-action="Index" class="btn btn-secondary">
            &larr; All Users
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<!-- ACCOUNT STATUS & ACTIONS -->
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 24px;">

    <!-- USER SUMMARY CARD -->
    <div class="content-card">
        <div class="card-header" style="padding: 16px 20px; border-bottom: 1px solid var(--seps-border);">
            <h2 style="font-size: 15px; font-weight: 600; margin: 0;">Account Information</h2>
        </div>
        <div style="padding: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; font-size: 14px;">
            <div>
                <div style="font-size: 12px; color: var(--seps-text-secondary);">Username</div>
                <div style="font-size: 16px; font-weight: 600;">@Model.Username</div>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--seps-text-secondary);">Account Status</div>
                <div style="margin-top: 2px;">
                    @if (Model.AccountStatus == "Active")
                    {
                        <span class="status-badge status-success">Active</span>
                    }
                    else if (Model.AccountStatus == "Locked")
                    {
                        <span class="status-badge status-danger">Locked (Failed Logins)</span>
                    }
                    else
                    {
                        <span class="status-badge status-neutral">@Model.AccountStatus</span>
                    }
                </div>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--seps-text-secondary);">Failed Login Attempts</div>
                <div style="font-size: 16px; font-weight: 500; color: @(Model.FailedLoginAttempts > 0 ? "var(--google-red)" : "inherit");">
                    @Model.FailedLoginAttempts / 5 allowed
                </div>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--seps-text-secondary);">MFA Status</div>
                <div style="font-size: 14px; font-weight: 600; color: @(Model.MfaEnabled ? "#10b981" : "#64748b");">
                    @(Model.MfaEnabled ? $"Active ({Model.MfaType ?? "TOTP"})" : "Not Enrolled")
                </div>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--seps-text-secondary);">Created At</div>
                <div>@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
            </div>
            <div style="grid-column: span 2;">
                <div style="font-size: 12px; color: var(--seps-text-secondary);">Linked Employee Record</div>
                @if (Model.Employee != null)
                {
                    <div style="margin-top: 4px;">
                        <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.EmployeeId" style="color: var(--seps-primary); font-weight: 500; text-decoration: none;">
                            @Model.Employee.FirstName @Model.Employee.LastName (ID: #@Model.EmployeeId)
                        </a>
                        - @(Model.Employee.Department?.DepartmentName ?? "N/A"), @(Model.Employee.Designation?.DesignationName ?? "N/A")
                    </div>
                }
                else
                {
                    <div style="color: var(--seps-text-secondary); margin-top: 4px;">No linked employee profile.</div>
                }
            </div>
        </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="content-card">
        <div class="card-header" style="padding: 16px 20px; border-bottom: 1px solid var(--seps-border);">
            <h2 style="font-size: 15px; font-weight: 600; margin: 0;">Security Operations</h2>
        </div>
        <div style="padding: 20px; display: flex; flex-direction: column; gap: 12px;">
            @if (Model.AccountStatus == "Locked" || Model.FailedLoginAttempts > 0)
            {
                <form asp-controller="UserManagement" asp-action="Unlock" asp-route-id="@Model.UserId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary" style="width: 100%;">
                        🔓 Unlock Account & Reset Counter
                    </button>
                </form>
            }

            <form asp-controller="UserManagement" asp-action="ToggleStatus" asp-route-id="@Model.UserId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-secondary" style="width: 100%;" onclick="return confirm('Toggle status for user @Model.Username?');">
                    @(Model.AccountStatus == "Active" ? "Deactivate Account" : "Activate Account")
                </button>
            </form>

            <form asp-controller="UserManagement" asp-action="ResetMfa" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@Model.UserId" />
                <button type="submit" class="btn btn-secondary" style="width: 100%;" onclick="return confirm('Reset MFA configuration for @Model.Username? The user will be required to re-enroll upon their next login.');">
                    🛡️ Reset User MFA / 2FA
                </button>
            </form>

            <button type="button" class="btn btn-secondary" style="width: 100%;" onclick="document.getElementById('pwdSection').style.display = document.getElementById('pwdSection').style.display === 'none' ? 'block' : 'none';">
                🔑 Reset User Password
            </button>
        </div>
    </div>

</div>

<!-- PASSWORD RESET PANEL (COLLAPSED BY DEFAULT) -->
<div id="pwdSection" class="content-card" style="display: none; margin-bottom: 24px; border-left: 4px solid var(--google-yellow);">
    <div class="card-header" style="padding: 16px 20px; border-bottom: 1px solid var(--seps-border);">
        <h2 style="font-size: 15px; font-weight: 600; margin: 0;">Administrative Password Reset</h2>
        <p style="font-size: 12px; color: var(--seps-text-secondary); margin: 2px 0 0;">Sets a new password for @Model.Username with PBKDF2 hashing</p>
    </div>
    <form asp-controller="UserManagement" asp-action="ResetPassword" method="post" style="padding: 20px; display: flex; gap: 12px; align-items: flex-end;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@Model.UserId" />

        <div class="form-group" style="flex: 1;">
            <label for="newPassword">New Secure Password (Min 6 chars) *</label>
            <input type="password" name="newPassword" id="newPassword" class="form-control" placeholder="Enter new password..." required minlength="6" />
        </div>

        <button type="submit" class="btn btn-primary" style="margin-bottom: 2px;" onclick="return confirm('Reset password for @Model.Username?');">
            Update Password
        </button>
    </form>
</div>

<!-- ROLE MAPPINGS -->
<div class="content-card" style="margin-bottom: 24px;">
    <div class="card-header" style="padding: 16px 20px; border-bottom: 1px solid var(--seps-border); display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h2 style="font-size: 15px; font-weight: 600; margin: 0;">Assigned Roles & Permissions</h2>
            <p style="font-size: 12px; color: var(--seps-text-secondary); margin: 2px 0 0;">Role-based access control grants</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Role ID</th>
                    <th>Role Name</th>
                    <th>Description</th>
                    <th>Assigned Date</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.UserRoleUsers.Any())
                {
                    foreach (var ur in Model.UserRoleUsers)
                    {
                        <tr>
                            <td><strong>#@ur.RoleId</strong></td>
                            <td><span class="status-badge status-neutral">@ur.Role.RoleName</span></td>
                            <td>@(ur.Role.Description ?? "Standard System Role")</td>
                            <td>@ur.AssignedAt.ToString("dd MMM yyyy, HH:mm")</td>
                            <td style="text-align: right;">
                                <form asp-controller="UserManagement" asp-action="RemoveRole" method="post" style="display:inline;" onsubmit="return confirm('Remove role @ur.Role.RoleName from @Model.Username?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@Model.UserId" />
                                    <input type="hidden" name="roleId" value="@ur.RoleId" />
                                    <button type="submit" class="btn btn-danger btn-sm">Remove Role</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-state">
                                <h3>No roles assigned</h3>
                                <p>Assign a role below to grant system access.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ASSIGN NEW ROLE FORM -->
    <div style="padding: 16px 20px; background: var(--seps-surface-variant, var(--surface-secondary)); border-top: 1px solid var(--seps-border);">
        <form asp-controller="UserManagement" asp-action="AssignRole" method="post" style="display: flex; gap: 12px; align-items: flex-end;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@Model.UserId" />

            <div class="form-group" style="flex: 1;">
                <label for="assignRoleId">Assign New Role</label>
                <select name="roleId" id="assignRoleId" class="form-control" required>
                    <option value="">-- Select Role --</option>
                    @foreach (var r in allRoles)
                    {
                        if (!Model.UserRoleUsers.Any(ur => ur.RoleId == r.RoleId))
                        {
                            <option value="@r.RoleId">@r.RoleName</option>
                        }
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary" style="margin-bottom: 2px;">
                + Assign Role
            </button>
        </form>
    </div>
</div>

<!-- AUDIT TRAIL FOR THIS USER -->
<div class="content-card">
    <div class="card-header">
        <div>
            <h2>Activity & Audit History</h2>
            <p>Recent events initiated by @Model.Username</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Record ID</th>
                    <th>Description</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AuditLogs.Any())
                {
                    foreach (var a in Model.AuditLogs)
                    {
                        <tr>
                            <td>@a.ActionDateTime.ToString("dd MMM yyyy, HH:mm:ss")</td>
                            <td><span class="status-badge status-neutral">@a.ActionType</span></td>
                            <td>@a.TableName</td>
                            <td>#@a.RecordId</td>
                            <td>@a.Description</td>
                            <td><code>@a.IpAddress</code></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <h3>No logged activity</h3>
                                <p>No audit log entries recorded for this user.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
