@model SecureEmployeePayrollSystem.Models.Designation

@{
    ViewData["Title"] = "Edit Designation";
}

<div class="page-header">
    <div>
        <h1>Edit Designation</h1>
        <p>Update title, seniority level, and scope for #@Model.DesignationId.</p>
    </div>
    <div class="page-header-actions">
        <a asp-controller="Designations" asp-action="Details" asp-route-id="@Model.DesignationId" class="btn btn-secondary">
            &larr; View Details
        </a>
    </div>
</div>

<div class="content-card">
    <div class="card-header">
        <div>
            <h2>Role Information</h2>
            <p>Editing record for @Model.DesignationName</p>
        </div>
    </div>

    <form asp-controller="Designations" asp-action="Edit" method="post" style="padding: 24px;">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="DesignationId" />

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
            <div class="form-group">
                <label asp-for="DesignationName">Designation Title *</label>
                <input asp-for="DesignationName" class="form-control" />
                <span asp-validation-for="DesignationName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="JobLevel">Seniority / Job Level *</label>
                <select asp-for="JobLevel" class="form-control">
                    <option value="Entry-Level">Entry-Level</option>
                    <option value="Associate">Associate</option>
                    <option value="Mid-Level">Mid-Level</option>
                    <option value="Senior">Senior</option>
                    <option value="Lead">Lead</option>
                    <option value="Manager">Manager</option>
                    <option value="Director">Director</option>
                    <option value="Executive">Executive</option>
                </select>
                <span asp-validation-for="JobLevel" class="field-validation-error"></span>
            </div>

            <div class="form-group" style="grid-column: span 2;">
                <label asp-for="Description">Role Description & Responsibilities</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>
        </div>

        <div class="form-actions" style="display: flex; gap: 12px; justify-content: flex-end; padding-top: 16px; border-top: 1px solid var(--seps-border);">
            <a asp-controller="Designations" asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</div>
