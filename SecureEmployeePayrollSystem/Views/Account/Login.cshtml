@model SecureEmployeePayrollSystem.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Sign in - Secure Employee Payroll System";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in - Secure Employee Payroll System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/seps-favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/seps-favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/seps-apple-touch-icon.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <script>
        (function() {
            var savedTheme = localStorage.getItem('seps-theme') || 
                (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>

<body>

    <main class="google-login-page" style="padding: 24px 16px;">

        <section class="split-login-wrapper">

            <!-- LEFT: FLOATING 24PX-ROUNDED FORM CARD (MATCHING IMAGE 1) -->
            <div class="split-login-form-side">

                <!-- BRAND HEADER -->
                <div style="margin-bottom: 24px;">
                    <div class="login-brand-logo-container">
                        <img src="~/images/seps-logo.png" alt="Secure Employee Payroll Management System" class="login-brand-logo-img" />
                    </div>

                    <h1 style="margin: 14px 0 4px; font-size: 22px; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em;">
                        Sign In to Your Account
                    </h1>
                    <p style="font-size: 13.5px; color: var(--text-secondary); margin: 0; line-height: 1.4;">
                        Access your administrative workspace or employee self-service portal.
                    </p>
                </div>

                <!-- ALERTS -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" style="margin-bottom: 16px; padding: 10px 14px; font-size: 13px;">
                        @TempData["SuccessMessage"]
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" style="margin-bottom: 16px; padding: 10px 14px; font-size: 13px;">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <!-- LOGIN FORM -->
                <form asp-controller="Account" asp-action="Login" method="post" autocomplete="on">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="validation-summary" style="margin-bottom: 16px;"></div>

                    <!-- USERNAME / EMAIL -->
                    <div style="margin-bottom: 16px;">
                        <label asp-for="UsernameOrEmail" style="display: block; font-size: 13px; font-weight: 500; color: var(--text-secondary); margin-bottom: 6px;">
                            Username or Work Email
                        </label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex; align-items: center; pointer-events: none;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </span>
                            <input asp-for="UsernameOrEmail" class="form-control" autocomplete="username" placeholder="Enter username or work email" autofocus style="padding-left: 42px; height: 44px; border-radius: 10px;" />
                        </div>
                        <span asp-validation-for="UsernameOrEmail" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <!-- PASSWORD -->
                    <div style="margin-bottom: 18px;">
                        <label asp-for="Password" style="display: block; font-size: 13px; font-weight: 500; color: var(--text-secondary); margin-bottom: 6px;">
                            Password
                        </label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex; align-items: center; pointer-events: none;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </span>
                            <input asp-for="Password" id="passwordInput" type="password" class="form-control" autocomplete="current-password" placeholder="Enter security credentials" style="padding-left: 42px; padding-right: 42px; height: 44px; border-radius: 10px;" />
                            <button type="button" id="togglePasswordBtn" aria-label="Toggle password visibility" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); display: flex; align-items: center;">
                                <svg id="eyeIcon" viewBox="0 0 24 24" style="width: 18px; height: 18px; fill: currentColor;">
                                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <!-- REMEMBER ME & FORGOT PASSWORD -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px;">
                        <label style="margin: 0; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; color: var(--text-secondary);">
                            <input asp-for="RememberMe" type="checkbox" style="width: 16px; height: 16px; accent-color: var(--primary); cursor: pointer;" />
                            <span>Keep me signed in</span>
                        </label>
                        <a asp-action="ForgotPassword" style="color: var(--link-color); text-decoration: none; font-size: 13px; font-weight: 500;">
                            Forgot Password?
                        </a>
                    </div>

                    <!-- SUBMIT BUTTON -->
                    <button type="submit" class="btn btn-primary" style="width: 100%; height: 46px; border-radius: 10px; font-size: 14.5px; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 14px rgba(29, 78, 216, 0.35);">
                        <span>Sign In</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>

                    <!-- OR DIVIDER -->
                    <div class="social-divider">
                        <span>Or continue with</span>
                    </div>

                    <!-- SOCIAL SSO BUTTONS -->
                    <div class="social-login-grid">
                        <button type="button" class="social-btn" onclick="alert('Microsoft Single Sign-On is configured for Azure AD federated tenants.')">
                            <svg width="18" height="18" viewBox="0 0 23 23">
                                <rect width="10.5" height="10.5" fill="#f25022"/>
                                <rect x="12.5" width="10.5" height="10.5" fill="#7fba00"/>
                                <rect y="12.5" width="10.5" height="10.5" fill="#00a4ef"/>
                                <rect x="12.5" y="12.5" width="10.5" height="10.5" fill="#ffb900"/>
                            </svg>
                            <span>Microsoft</span>
                        </button>
                        <button type="button" class="social-btn" onclick="alert('Google Workspace SSO is configured for organizational domains.')">
                            <svg width="18" height="18" viewBox="0 0 24 24">
                                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                            </svg>
                            <span>Google</span>
                        </button>
                    </div>

                    <!-- DEMO ACCOUNTS ACCORDION -->
                    <details style="margin-top: 14px; background: var(--surface-secondary); border: 1px solid var(--border-color); border-radius: 10px; padding: 10px 14px; font-size: 12.5px;">
                        <summary style="font-weight: 600; color: var(--text-primary); cursor: pointer; outline: none;">
                            🔑 Quick Evaluation Accounts (Click to reveal)
                        </summary>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--divider-color); color: var(--text-secondary);">
                            <div onclick="fillCredentials('tanuj.garg', 'Admin@123')" style="cursor: pointer; padding: 6px 8px; background: var(--surface-bg); border-radius: 6px; border: 1px solid var(--border-color);">
                                <strong style="color: var(--primary);">Admin:</strong> tanuj.garg
                                <div style="font-size: 11px; color: var(--text-muted);">Pass: Admin@123 (Tanuj Garg)</div>
                            </div>
                            <div onclick="fillCredentials('riya.sharma', 'Hr@123')" style="cursor: pointer; padding: 6px 8px; background: var(--surface-bg); border-radius: 6px; border: 1px solid var(--border-color);">
                                <strong style="color: var(--success);">HR:</strong> riya.sharma
                                <div style="font-size: 11px; color: var(--text-muted);">Pass: Hr@123</div>
                            </div>
                            <div onclick="fillCredentials('vikram.singh', 'Payroll@123')" style="cursor: pointer; padding: 6px 8px; background: var(--surface-bg); border-radius: 6px; border: 1px solid var(--border-color);">
                                <strong style="color: var(--warning);">Payroll:</strong> vikram.singh
                                <div style="font-size: 11px; color: var(--text-muted);">Pass: Payroll@123</div>
                            </div>
                            <div onclick="fillCredentials('kabir.verma', 'Emp@123')" style="cursor: pointer; padding: 6px 8px; background: var(--surface-bg); border-radius: 6px; border: 1px solid var(--border-color);">
                                <strong style="color: #7c3aed;">Employee:</strong> kabir.verma
                                <div style="font-size: 11px; color: var(--text-muted);">Pass: Emp@123</div>
                            </div>
                        </div>
                    </details>

                    <!-- REGISTER LINK -->
                    <div style="text-align: center; margin-top: 18px; font-size: 13px; color: var(--text-secondary);">
                        Employee without an account?
                        <a asp-action="Register" style="color: var(--link-color); text-decoration: none; font-weight: 600; margin-left: 4px;">
                            Activate Account
                        </a>
                    </div>
                </form>

                <!-- 3 VALUE CAPSULES AT CARD BASE -->
                <div style="display: flex; justify-content: center; gap: 10px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--divider-color);">
                    <div class="login-badge-item">
                        <span style="color: var(--primary);">🔒</span> Secure
                    </div>
                    <div class="login-badge-item">
                        <span style="color: var(--warning);">⚡</span> Reliable
                    </div>
                    <div class="login-badge-item">
                        <span style="color: var(--success);">📊</span> Efficient
                    </div>
                </div>

            </div>

            <!-- RIGHT: GRAND CORPORATE HERO & GLASSMORPHISM FEATURE CARDS (MATCHING IMAGE 1) -->
            <div class="split-login-hero-side">

                <!-- TOP BAR: THEME TOGGLE PILL -->
                <div class="split-login-hero-top">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(10px); padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.25);">
                            SEPS Enterprise Suite
                        </span>
                    </div>

                    <!-- THEME TOGGLE BUTTON -->
                    <button type="button" class="theme-toggle-btn" aria-label="Toggle dark/light theme" title="Toggle Theme" style="background: rgba(255, 255, 255, 0.18); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 20px; padding: 6px 14px; color: #ffffff; display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 12px; font-weight: 500;">
                        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" style="width: 16px; height: 16px; fill: currentColor;">
                            <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" />
                        </svg>
                        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" style="width: 16px; height: 16px; fill: currentColor; display: none;">
                            <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z" />
                        </svg>
                        <span>Theme</span>
                    </button>
                </div>

                <!-- MAIN HEADLINE & SUBTITLE -->
                <div class="split-login-hero-content">
                    <h2 class="split-login-hero-title">
                        Empowering People<br />Building a Better Tomorrow
                    </h2>
                    <p class="split-login-hero-subtitle">
                        Streamline workforce operations, calculate accurate payroll, ensure enterprise security compliance, and foster organizational growth with SEPS.
                    </p>

                    <!-- 4 GLASSMORPHISM FEATURE CARDS (2x2 GRID) -->
                    <div class="login-feature-grid">
                        <div class="login-feature-card">
                            <div class="login-feature-icon" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                            </div>
                            <div>
                                <div class="login-feature-title">Attendance Tracking</div>
                                <div class="login-feature-desc">Real-time daily clocking, shift audits, and biometric validation.</div>
                            </div>
                        </div>

                        <div class="login-feature-card">
                            <div class="login-feature-icon" style="background: rgba(16, 185, 129, 0.2); color: #34d399;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </div>
                            <div>
                                <div class="login-feature-title">Employee Management</div>
                                <div class="login-feature-desc">Centralized personnel records, department hierarchies, and roles.</div>
                            </div>
                        </div>

                        <div class="login-feature-card">
                            <div class="login-feature-icon" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="12" y1="1" x2="12" y2="23"></line>
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                </svg>
                            </div>
                            <div>
                                <div class="login-feature-title">Payroll Processing</div>
                                <div class="login-feature-desc">One-click salary disbursement, PF/ESI statutory tax deductions.</div>
                            </div>
                        </div>

                        <div class="login-feature-card">
                            <div class="login-feature-icon" style="background: rgba(168, 85, 247, 0.2); color: #c084fc;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="18" y1="20" x2="18" y2="10"></line>
                                    <line x1="12" y1="20" x2="12" y2="4"></line>
                                    <line x1="6" y1="20" x2="6" y2="14"></line>
                                </svg>
                            </div>
                            <div>
                                <div class="login-feature-title">Reports & Analytics</div>
                                <div class="login-feature-desc">Audited financial summaries, CSV/PDF exports, and visual metrics.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- HERO FOOTER -->
                <div class="split-login-hero-footer">
                    <div>© 2026 Secure Employee Payroll System • Enterprise v2.5</div>
                    <div style="display: flex; gap: 16px;">
                        <span style="color: #cbd5e1; cursor: pointer;">Privacy Policy</span>
                        <span>•</span>
                        <span style="color: #cbd5e1; cursor: pointer;">Security Whitepaper</span>
                    </div>
                </div>

            </div>

        </section>

    </main>

    <!-- SCRIPTS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Password Show/Hide Toggle
        const pwdInput = document.getElementById('passwordInput');
        const toggleBtn = document.getElementById('togglePasswordBtn');
        if (pwdInput && toggleBtn) {
            toggleBtn.addEventListener('click', () => {
                const isPwd = pwdInput.getAttribute('type') === 'password';
                pwdInput.setAttribute('type', isPwd ? 'text' : 'password');
            });
        }

        // Quick Credentials Filler for Evaluation
        function fillCredentials(user, pass) {
            const userInput = document.querySelector('input[name="UsernameOrEmail"]');
            if (userInput) userInput.value = user;
            if (pwdInput) pwdInput.value = pass;
        }
    </script>
</body>

</html>