@model SecureEmployeePayrollSystem.ViewModels.MfaChallengeViewModel

@{
    Layout = null;
    ViewData["Title"] = "Two-Step Verification - SEPS";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Two-Step Verification - Secure Employee Payroll System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/seps-favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/seps-favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/seps-apple-touch-icon.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <script>
        (function() {
            var savedTheme = localStorage.getItem('seps-theme') || 
                (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <style>
        .mfa-method-tab {
            flex: 1;
            padding: 10px 8px;
            font-size: 13px;
            font-weight: 600;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: var(--surface-bg);
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.2s ease;
        }
        .mfa-method-tab.active {
            background: var(--primary);
            color: var(--primary-text);
            border-color: var(--primary);
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25);
        }
        .otp-input-field {
            font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
            font-size: 26px;
            letter-spacing: 8px;
            text-align: center;
            font-weight: 700;
            height: 54px;
            border-radius: 10px;
            border: 2px solid var(--border-color);
            background: var(--surface-bg);
            color: var(--text-primary);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .otp-input-field:focus {
            outline: none;
            border-color: var(--focus-ring);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
        }
    </style>
</head>

<body>
    <main class="google-login-page" style="padding: 24px 16px; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
        <div style="width: 100%; max-width: 480px; background: var(--surface-bg); border: 1px solid var(--border-color); border-radius: 20px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08); padding: 36px 32px;">

            <!-- THEME TOGGLE -->
            <div style="display: flex; justify-content: flex-end; margin-bottom: 8px;">
                <button type="button" class="theme-toggle-btn" aria-label="Toggle dark/light theme" title="Toggle Theme" style="background: var(--surface-secondary); border: 1px solid var(--border-color); border-radius: 20px; padding: 4px 12px; color: var(--text-primary); display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 11.5px; font-weight: 500;">
                    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" style="width: 14px; height: 14px; fill: currentColor;">
                        <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" />
                    </svg>
                    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" style="width: 14px; height: 14px; fill: currentColor; display: none;">
                        <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z" />
                    </svg>
                    <span class="theme-label-text">Theme</span>
                </button>
            </div>

            <!-- HEADER -->
            <div style="text-align: center; margin-bottom: 28px;">
                <div style="width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35); margin-bottom: 16px;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <path d="m9 12 2 2 4-4"></path>
                    </svg>
                </div>
                <h1 style="margin: 0 0 6px; font-size: 24px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.02em;">
                    Two-Step Verification
                </h1>
                <p style="font-size: 13.5px; color: var(--text-secondary); margin: 0; line-height: 1.5;">
                    Verify your identity to protect administrative & payroll records.
                </p>
            </div>

            <!-- ALERTS -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 14px; font-size: 13px; border-radius: 8px;">
                    @TempData["ErrorMessage"]
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 14px; font-size: 13px; border-radius: 8px;">
                    @TempData["SuccessMessage"]
                </div>
            }

            <!-- METHOD SELECTION TABS -->
            <div style="display: flex; gap: 8px; margin-bottom: 24px;">
                @if (Model.HasTotp)
                {
                    <button type="button" id="tabTotp" class="mfa-method-tab @(Model.Method == "TOTP" ? "active" : "")" onclick="selectMethod('TOTP')">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                            <line x1="12" y1="18" x2="12.01" y2="18"></line>
                        </svg>
                        Authenticator
                    </button>
                }
                @if (Model.HasEmail)
                {
                    <button type="button" id="tabEmail" class="mfa-method-tab @(Model.Method == "EMAIL" ? "active" : "")" onclick="selectMethod('EMAIL')">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                        Email OTP
                    </button>
                }
                @if (Model.HasRecovery)
                {
                    <button type="button" id="tabRecovery" class="mfa-method-tab @(Model.Method == "RECOVERY" ? "active" : "")" onclick="selectMethod('RECOVERY')">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        Recovery Code
                    </button>
                }
            </div>

            <!-- CHALLENGE FORM -->
            <form asp-controller="Account" asp-action="MfaChallenge" method="post" id="mfaChallengeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ChallengeToken" />
                <input type="hidden" asp-for="Method" id="selectedMethod" />
                <input type="hidden" asp-for="RememberMe" />
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="validation-summary" style="margin-bottom: 18px; font-size: 13px; color: #ef4444;"></div>

                <!-- DESCRIPTION BASED ON ACTIVE METHOD -->
                <div id="methodPrompt" style="margin-bottom: 20px; font-size: 13.5px; color: var(--text-secondary); text-align: center; min-height: 40px;">
                    @if (Model.Method == "TOTP")
                    {
                        <span>Enter the 6-digit verification code from your Google Authenticator or TOTP app:</span>
                    }
                    else if (Model.Method == "EMAIL")
                    {
                        <span>A 6-digit verification code was sent to <strong>@Model.MaskedEmail</strong>. Enter it below:</span>
                    }
                    else
                    {
                        <span>Enter an unused emergency backup recovery code (format: <strong>XXXX-XXXX</strong>):</span>
                    }
                </div>

                <!-- CODE INPUT -->
                <div style="margin-bottom: 20px;">
                    <input asp-for="Code" id="mfaCodeInput" class="otp-input-field form-control"
                           maxlength="@(Model.Method == "RECOVERY" ? 10 : 6)"
                           autofocus autocomplete="one-time-code"
                           placeholder="@(Model.Method == "RECOVERY" ? "ABCD-1234" : "000000")" />
                    <span asp-validation-for="Code" class="text-danger" style="font-size: 12px; display: block; text-align: center; margin-top: 6px;"></span>
                </div>

                <!-- EMAIL RESEND TRIGGER -->
                <div id="emailResendContainer" style="display: @(Model.Method == "EMAIL" ? "block" : "none"); text-align: center; margin-bottom: 20px;">
                    <button type="button" id="btnResendOtp" onclick="resendEmailOtp()" style="background: none; border: none; color: var(--link-color); font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: underline; padding: 0;">
                        Didn't receive the code? Resend Email OTP
                    </button>
                    <div id="resendStatus" style="font-size: 12px; margin-top: 6px; color: var(--text-secondary);"></div>
                </div>

                <!-- SUBMIT BUTTON -->
                <button type="submit" id="btnSubmitMfa" class="btn btn-primary" style="width: 100%; height: 46px; font-size: 15px; font-weight: 700; border-radius: 10px; display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                    </svg>
                    Verify & Continue
                </button>
            </form>

            <!-- FOOTER LINKS -->
            <div style="margin-top: 24px; text-align: center; border-top: 1px solid var(--border-color); padding-top: 16px;">
                <a asp-controller="Account" asp-action="Login" style="font-size: 13px; color: var(--text-secondary); text-decoration: none; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                    Cancel & Return to Login
                </a>
            </div>

            <!-- SECURITY BADGE -->
            <div style="margin-top: 18px; text-align: center; font-size: 11.5px; color: var(--text-muted); display: flex; align-items: center; justify-content: center; gap: 6px;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>Hardware Token & RFC 6238 TOTP Standard Protected</span>
            </div>

        </div>
    </main>

    <script>
        function selectMethod(method) {
            document.getElementById('selectedMethod').value = method;
            
            var tabs = document.querySelectorAll('.mfa-method-tab');
            tabs.forEach(function(tab) { tab.classList.remove('active'); });

            var codeInput = document.getElementById('mfaCodeInput');
            var prompt = document.getElementById('methodPrompt');
            var resendBox = document.getElementById('emailResendContainer');

            codeInput.value = '';

            if (method === 'TOTP') {
                var tab = document.getElementById('tabTotp');
                if (tab) tab.classList.add('active');
                prompt.innerHTML = 'Enter the 6-digit verification code from your Google Authenticator or TOTP app:';
                codeInput.maxLength = 6;
                codeInput.placeholder = '000000';
                resendBox.style.display = 'none';
            } else if (method === 'EMAIL') {
                var tab = document.getElementById('tabEmail');
                if (tab) tab.classList.add('active');
                prompt.innerHTML = 'A 6-digit verification code was sent to <strong>@Model.MaskedEmail</strong>. Enter it below:';
                codeInput.maxLength = 6;
                codeInput.placeholder = '000000';
                resendBox.style.display = 'block';
            } else if (method === 'RECOVERY') {
                var tab = document.getElementById('tabRecovery');
                if (tab) tab.classList.add('active');
                prompt.innerHTML = 'Enter an unused emergency backup recovery code (format: <strong>XXXX-XXXX</strong>):';
                codeInput.maxLength = 10;
                codeInput.placeholder = 'ABCD-1234';
                resendBox.style.display = 'none';
            }

            codeInput.focus();
        }

        function resendEmailOtp() {
            var btn = document.getElementById('btnResendOtp');
            var status = document.getElementById('resendStatus');
            btn.disabled = true;
            btn.innerText = 'Sending new code...';
            status.innerText = '';

            var token = '@Model.ChallengeToken';
            var form = document.getElementById('mfaChallengeForm');
            var csrf = form.querySelector('input[name="__RequestVerificationToken"]').value;

            var formData = new FormData();
            formData.append('challengeToken', token);
            formData.append('__RequestVerificationToken', csrf);

            fetch('@Url.Action("ResendEmailOtp", "Account")', {
                method: 'POST',
                body: formData
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.success) {
                    status.style.color = '#10b981';
                    status.innerText = data.message;
                    // Cooldown 60s
                    var cooldown = 60;
                    var interval = setInterval(function() {
                        cooldown--;
                        if (cooldown <= 0) {
                            clearInterval(interval);
                            btn.disabled = false;
                            btn.innerText = "Didn't receive the code? Resend Email OTP";
                        } else {
                            btn.innerText = 'Resend available in ' + cooldown + 's';
                        }
                    }, 1000);
                } else {
                    status.style.color = '#ef4444';
                    status.innerText = data.message;
                    btn.disabled = false;
                    btn.innerText = "Didn't receive the code? Resend Email OTP";
                }
            })
            .catch(function(err) {
                status.style.color = '#ef4444';
                status.innerText = 'Network error sending code. Please try again.';
                btn.disabled = false;
                btn.innerText = "Didn't receive the code? Resend Email OTP";
            });
        }
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
