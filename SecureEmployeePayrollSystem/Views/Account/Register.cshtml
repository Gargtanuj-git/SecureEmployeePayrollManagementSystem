@model SecureEmployeePayrollSystem.ViewModels.RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Activate Account - Secure Employee Payroll System";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Activate Account - Secure Employee Payroll System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/seps-favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/seps-favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/seps-apple-touch-icon.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <script>
        (function() {
            var savedTheme = localStorage.getItem('seps-theme') || 
                (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>

<body>

    <main class="google-login-page" style="padding: 24px 16px;">

        <section class="split-login-wrapper">

            <!-- LEFT: FLOATING FORM CARD -->
            <div class="split-login-form-side">

                <!-- BRAND HEADER -->
                <div style="margin-bottom: 20px;">
                    <div class="login-brand-logo-container">
                        <img src="~/images/seps-logo.png" alt="Secure Employee Payroll Management System" class="login-brand-logo-img" />
                    </div>

                    <h1 style="margin: 12px 0 4px; font-size: 21px; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em;">
                        Activate Employee Account
                    </h1>
                    <p style="font-size: 13px; color: var(--text-secondary); margin: 0; line-height: 1.4;">
                        Self-service onboarding for registered enterprise employees.
                    </p>
                </div>

                <!-- ALERTS -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" style="margin-bottom: 14px; padding: 10px 14px; font-size: 13px;">
                        @TempData["SuccessMessage"]
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" style="margin-bottom: 14px; padding: 10px 14px; font-size: 13px;">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <!-- REGISTRATION FORM -->
                <form asp-controller="Account" asp-action="Register" method="post" autocomplete="on">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary" style="margin-bottom: 14px;"></div>

                    <!-- EMPLOYEE ID -->
                    <div style="margin-bottom: 14px;">
                        <label asp-for="EmployeeId" style="display: block; font-size: 12.5px; font-weight: 500; color: var(--text-secondary); margin-bottom: 5px;">
                            Employee ID <span style="color: var(--danger); font-size: 12px;">*</span>
                        </label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex; align-items: center; pointer-events: none;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                </svg>
                            </span>
                            <input asp-for="EmployeeId" type="number" class="form-control" placeholder="e.g. 1001" autofocus style="padding-left: 42px; height: 42px; border-radius: 10px;" />
                        </div>
                        <span asp-validation-for="EmployeeId" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <!-- WORK EMAIL -->
                    <div style="margin-bottom: 14px;">
                        <label asp-for="Email" style="display: block; font-size: 12.5px; font-weight: 500; color: var(--text-secondary); margin-bottom: 5px;">
                            Registered Work Email <span style="color: var(--danger); font-size: 12px;">*</span>
                        </label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex; align-items: center; pointer-events: none;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                            </span>
                            <input asp-for="Email" type="email" class="form-control" placeholder="name@company.com" style="padding-left: 42px; height: 42px; border-radius: 10px;" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <!-- USERNAME -->
                    <div style="margin-bottom: 14px;">
                        <label asp-for="Username" style="display: block; font-size: 12.5px; font-weight: 500; color: var(--text-secondary); margin-bottom: 5px;">
                            Desired Username <span style="color: var(--danger); font-size: 12px;">*</span>
                        </label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex; align-items: center; pointer-events: none;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </span>
                            <input asp-for="Username" class="form-control" autocomplete="username" placeholder="Choose a username (min 3 chars)" style="padding-left: 42px; height: 42px; border-radius: 10px;" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <!-- PASSWORD -->
                    <div style="margin-bottom: 14px;">
                        <label asp-for="Password" style="display: block; font-size: 12.5px; font-weight: 500; color: var(--text-secondary); margin-bottom: 5px;">
                            Password <span style="color: var(--danger); font-size: 12px;">*</span>
                        </label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex; align-items: center; pointer-events: none;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </span>
                            <input asp-for="Password" id="regPasswordInput" type="password" class="form-control" autocomplete="new-password" placeholder="Create strong password (min 6 chars)" style="padding-left: 42px; padding-right: 42px; height: 42px; border-radius: 10px;" />
                            <button type="button" id="toggleRegPasswordBtn" aria-label="Toggle password visibility" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); display: flex; align-items: center;">
                                <svg viewBox="0 0 24 24" style="width: 18px; height: 18px; fill: currentColor;">
                                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <!-- CONFIRM PASSWORD -->
                    <div style="margin-bottom: 20px;">
                        <label asp-for="ConfirmPassword" style="display: block; font-size: 12.5px; font-weight: 500; color: var(--text-secondary); margin-bottom: 5px;">
                            Confirm Password <span style="color: var(--danger); font-size: 12px;">*</span>
                        </label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex; align-items: center; pointer-events: none;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                            </span>
                            <input asp-for="ConfirmPassword" id="regConfirmPasswordInput" type="password" class="form-control" autocomplete="new-password" placeholder="Confirm your password" style="padding-left: 42px; padding-right: 42px; height: 42px; border-radius: 10px;" />
                            <button type="button" id="toggleRegConfirmBtn" aria-label="Toggle password confirmation visibility" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); display: flex; align-items: center;">
                                <svg viewBox="0 0 24 24" style="width: 18px; height: 18px; fill: currentColor;">
                                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <!-- SUBMIT BUTTON -->
                    <button type="submit" style="width: 100%; height: 44px; border-radius: 10px; border: none; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #ffffff; font-size: 14px; font-weight: 600; cursor: pointer; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35); display: flex; align-items: center; justify-content: center; gap: 8px; transition: transform 0.15s ease, box-shadow 0.15s ease;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="8.5" cy="7" r="4"></circle>
                            <line x1="20" y1="8" x2="20" y2="14"></line>
                            <line x1="23" y1="11" x2="17" y2="11"></line>
                        </svg>
                        <span>Activate Account</span>
                    </button>

                    <!-- SIGN IN LINK -->
                    <div style="text-align: center; margin-top: 16px; font-size: 13px; color: var(--text-secondary);">
                        Already registered and active?
                        <a asp-action="Login" style="color: var(--link-color); text-decoration: none; font-weight: 600; margin-left: 4px;">
                            Sign in here
                        </a>
                    </div>
                </form>

                <!-- 3 VALUE CAPSULES AT CARD BASE -->
                <div style="display: flex; justify-content: center; gap: 10px; margin-top: 20px; padding-top: 14px; border-top: 1px solid var(--divider-color);">
                    <div class="login-badge-item">
                        <span style="color: var(--primary);">🔒</span> Verified ID
                    </div>
                    <div class="login-badge-item">
                        <span style="color: var(--warning);">⚡</span> Instant Setup
                    </div>
                    <div class="login-badge-item">
                        <span style="color: var(--success);">🛡️</span> RBAC Protected
                    </div>
                </div>

            </div>

            <!-- RIGHT: GRAND CORPORATE HERO SIDE -->
            <div class="split-login-hero-side" style="background-image: url('/images/auth/team-collaboration.jpg');">

                <!-- TOP BAR: THEME TOGGLE PILL -->
                <div class="split-login-hero-top">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(10px); padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.25);">
                            SEPS Employee Onboarding
                        </span>
                    </div>

                    <!-- THEME TOGGLE BUTTON -->
                    <button type="button" class="theme-toggle-btn" aria-label="Toggle dark/light theme" title="Toggle Theme" style="background: rgba(255, 255, 255, 0.18); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 20px; padding: 6px 14px; color: #ffffff; display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 12px; font-weight: 500;">
                        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" style="width: 16px; height: 16px; fill: currentColor;">
                            <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" />
                        </svg>
                        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" style="width: 16px; height: 16px; fill: currentColor; display: none;">
                            <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z" />
                        </svg>
                        <span>Theme</span>
                    </button>
                </div>

                <!-- MAIN HEADLINE & SUBTITLE -->
                <div class="split-login-hero-content">
                    <h2 class="split-login-hero-title">
                        Join the Modern Workforce<br />Seamless Self-Service
                    </h2>
                    <p class="split-login-hero-subtitle">
                        Activate your verified self-service credentials to access automated payroll slips, clock daily attendance, request leaves, and manage your tax documents securely.
                    </p>

                    <!-- 4 GLASSMORPHISM FEATURE CARDS (2x2 GRID) -->
                    <div class="login-feature-grid">
                        <div class="login-feature-card">
                            <div class="login-feature-icon" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                            </div>
                            <div>
                                <div class="login-feature-title">Digital Payslips</div>
                                <div class="login-feature-desc">Itemized monthly slips with PF/ESI deductions and tax compliance.</div>
                            </div>
                        </div>

                        <div class="login-feature-card">
                            <div class="login-feature-icon" style="background: rgba(16, 185, 129, 0.2); color: #34d399;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                            </div>
                            <div>
                                <div class="login-feature-title">Attendance Tracking</div>
                                <div class="login-feature-desc">Real-time shift clocking, verified presence logs, and monthly hours.</div>
                            </div>
                        </div>

                        <div class="login-feature-card">
                            <div class="login-feature-icon" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                            </div>
                            <div>
                                <div class="login-feature-title">Leave Management</div>
                                <div class="login-feature-desc">Apply for annual and casual leaves with instant approval workflows.</div>
                            </div>
                        </div>

                        <div class="login-feature-card">
                            <div class="login-feature-icon" style="background: rgba(168, 85, 247, 0.2); color: #c084fc;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </div>
                            <div>
                                <div class="login-feature-title">Enterprise Security</div>
                                <div class="login-feature-desc">Encrypted credential storage, session tokens, and zero-trust verification.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- HERO FOOTER -->
                <div class="split-login-hero-footer">
                    <div>© 2026 Secure Employee Payroll System • Enterprise v2.5</div>
                    <div style="display: flex; gap: 16px;">
                        <span style="color: #cbd5e1; cursor: pointer;">Privacy Policy</span>
                        <span>•</span>
                        <span style="color: #cbd5e1; cursor: pointer;">Security Whitepaper</span>
                    </div>
                </div>

            </div>

        </section>

    </main>

    <!-- SCRIPTS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Password Show/Hide Toggle
        const regPwdInput = document.getElementById('regPasswordInput');
        const toggleRegBtn = document.getElementById('toggleRegPasswordBtn');
        if (regPwdInput && toggleRegBtn) {
            toggleRegBtn.addEventListener('click', () => {
                const isPwd = regPwdInput.getAttribute('type') === 'password';
                regPwdInput.setAttribute('type', isPwd ? 'text' : 'password');
            });
        }

        const regConfirmInput = document.getElementById('regConfirmPasswordInput');
        const toggleRegConfirmBtn = document.getElementById('toggleRegConfirmBtn');
        if (regConfirmInput && toggleRegConfirmBtn) {
            toggleRegConfirmBtn.addEventListener('click', () => {
                const isPwd = regConfirmInput.getAttribute('type') === 'password';
                regConfirmInput.setAttribute('type', isPwd ? 'text' : 'password');
            });
        }
    </script>
</body>

</html>
