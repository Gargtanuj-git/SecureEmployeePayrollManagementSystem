@model SecureEmployeePayrollSystem.ViewModels.ResetPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Reset Password - Secure Employee Payroll System";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - Secure Employee Payroll System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/seps-favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/seps-favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/seps-apple-touch-icon.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <script>
        (function() {
            var savedTheme = localStorage.getItem('seps-theme') || 
                (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>

<body>

    <main class="google-login-page" style="padding: 24px 16px;">

        <section class="split-login-wrapper">

            <!-- LEFT: FORM SIDE -->
            <div class="split-login-form-side">

                <!-- BRAND HEADER -->
                <div style="margin-bottom: 24px;">
                    <div class="login-brand-logo-container">
                        <img src="~/images/seps-logo.png" alt="Secure Employee Payroll Management System" class="login-brand-logo-img" />
                    </div>

                    <h1 style="margin: 14px 0 4px; font-size: 22px; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em;">
                        Reset Account Password
                    </h1>
                    <p style="font-size: 13.5px; color: var(--text-secondary); margin: 0; line-height: 1.4;">
                        Enter a new secure password for account <strong>@Model.Username</strong>.
                    </p>
                </div>

                <!-- ALERTS -->
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" style="margin-bottom: 16px; padding: 10px 14px; font-size: 13px;">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <!-- RESET PASSWORD FORM -->
                <form asp-controller="Account" asp-action="ResetPassword" method="post" autocomplete="on">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Username" />
                    <input type="hidden" asp-for="Token" />

                    <div asp-validation-summary="ModelOnly" class="validation-summary" style="margin-bottom: 16px;"></div>

                    <!-- NEW PASSWORD -->
                    <div style="margin-bottom: 18px;">
                        <label asp-for="NewPassword" style="display: block; font-size: 13px; font-weight: 500; color: var(--text-secondary); margin-bottom: 6px;">
                            New Password <span style="color: var(--danger);">*</span>
                        </label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex; align-items: center; pointer-events: none;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </span>
                            <input asp-for="NewPassword" id="newPwdInput" type="password" class="form-control" autocomplete="new-password" placeholder="Enter new password (min 6 chars)" autofocus style="padding-left: 42px; padding-right: 42px; height: 44px; border-radius: 10px;" />
                            <button type="button" id="toggleNewPwdBtn" aria-label="Toggle password visibility" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); display: flex; align-items: center;">
                                <svg viewBox="0 0 24 24" style="width: 18px; height: 18px; fill: currentColor;">
                                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <!-- CONFIRM PASSWORD -->
                    <div style="margin-bottom: 22px;">
                        <label asp-for="ConfirmPassword" style="display: block; font-size: 13px; font-weight: 500; color: var(--text-secondary); margin-bottom: 6px;">
                            Confirm New Password <span style="color: var(--danger);">*</span>
                        </label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex; align-items: center; pointer-events: none;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                            </span>
                            <input asp-for="ConfirmPassword" id="confirmPwdInput" type="password" class="form-control" autocomplete="new-password" placeholder="Confirm your new password" style="padding-left: 42px; padding-right: 42px; height: 44px; border-radius: 10px;" />
                            <button type="button" id="toggleConfirmPwdBtn" aria-label="Toggle password confirmation visibility" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); display: flex; align-items: center;">
                                <svg viewBox="0 0 24 24" style="width: 18px; height: 18px; fill: currentColor;">
                                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <!-- SUBMIT BUTTON -->
                    <button type="submit" style="width: 100%; height: 44px; border-radius: 10px; border: none; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #ffffff; font-size: 14.5px; font-weight: 600; cursor: pointer; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35); display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Update Password and Sign In</span>
                    </button>

                    <!-- CANCEL LINK -->
                    <div style="text-align: center; margin-top: 18px; font-size: 13px;">
                        <a asp-action="Login" style="color: var(--link-color); text-decoration: none; font-weight: 500;">
                            ← Cancel and Return to Sign In
                        </a>
                    </div>
                </form>

                <!-- CARD BASE BADGES -->
                <div style="display: flex; justify-content: center; gap: 10px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--divider-color);">
                    <div class="login-badge-item">
                        <span style="color: var(--primary);">🔒</span> Single-Use Token
                    </div>
                    <div class="login-badge-item">
                        <span style="color: var(--warning);">⚡</span> SHA-256 Hashed
                    </div>
                    <div class="login-badge-item">
                        <span style="color: var(--success);">🛡️</span> Audited
                    </div>
                </div>

            </div>

            <!-- RIGHT: HERO SIDE -->
            <div class="split-login-hero-side">

                <!-- TOP BAR -->
                <div class="split-login-hero-top">
                    <div>
                        <span style="background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(10px); padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.25);">
                            SEPS Security Suite
                        </span>
                    </div>

                    <!-- THEME TOGGLE -->
                    <button type="button" class="theme-toggle-btn" aria-label="Toggle dark/light theme" title="Toggle Theme" style="background: rgba(255, 255, 255, 0.18); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 20px; padding: 6px 14px; color: #ffffff; display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 12px; font-weight: 500;">
                        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" style="width: 16px; height: 16px; fill: currentColor;">
                            <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" />
                        </svg>
                        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" style="width: 16px; height: 16px; fill: currentColor; display: none;">
                            <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z" />
                        </svg>
                        <span>Theme</span>
                    </button>
                </div>

                <!-- HERO CONTENT -->
                <div class="split-login-hero-content">
                    <h2 class="split-login-hero-title">
                        Advanced Enterprise Security<br />Protecting Corporate Data
                    </h2>
                    <p class="split-login-hero-subtitle">
                        All passwords are encrypted with ASP.NET Core Identity v3 PBKDF2 cryptography. Tokens are single-use, hashed with SHA-256, and verified with constant-time equality.
                    </p>

                    <div class="login-feature-grid">
                        <div class="login-feature-card">
                            <div class="login-feature-icon" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </div>
                            <div>
                                <div class="login-feature-title">PBKDF2 Cryptography</div>
                                <div class="login-feature-desc">Industry-grade salted key derivation prevents dictionary attacks.</div>
                            </div>
                        </div>

                        <div class="login-feature-card">
                            <div class="login-feature-icon" style="background: rgba(16, 185, 129, 0.2); color: #34d399;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </div>
                            <div>
                                <div class="login-feature-title">Single-Use Tokens</div>
                                <div class="login-feature-desc">Tokens are immediately consumed and burned upon password change.</div>
                            </div>
                        </div>

                        <div class="login-feature-card">
                            <div class="login-feature-icon" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                            </div>
                            <div>
                                <div class="login-feature-title">Strict 15-Min Expiry</div>
                                <div class="login-feature-desc">Tight temporal bounds prevent token harvesting and replay.</div>
                            </div>
                        </div>

                        <div class="login-feature-card">
                            <div class="login-feature-icon" style="background: rgba(168, 85, 247, 0.2); color: #c084fc;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                            </div>
                            <div>
                                <div class="login-feature-title">Audit Logging</div>
                                <div class="login-feature-desc">All credential updates are recorded in immutable audit logs.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- HERO FOOTER -->
                <div class="split-login-hero-footer">
                    <div>© 2026 Secure Employee Payroll System • Enterprise v2.5</div>
                    <div style="display: flex; gap: 16px;">
                        <span style="color: #cbd5e1; cursor: pointer;">Privacy Policy</span>
                        <span>•</span>
                        <span style="color: #cbd5e1; cursor: pointer;">Security Whitepaper</span>
                    </div>
                </div>

            </div>

        </section>

    </main>

    <!-- SCRIPTS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        const newPwd = document.getElementById('newPwdInput');
        const toggleNewBtn = document.getElementById('toggleNewPwdBtn');
        if (newPwd && toggleNewBtn) {
            toggleNewBtn.addEventListener('click', () => {
                const isPwd = newPwd.getAttribute('type') === 'password';
                newPwd.setAttribute('type', isPwd ? 'text' : 'password');
            });
        }

        const confirmPwd = document.getElementById('confirmPwdInput');
        const toggleConfirmBtn = document.getElementById('toggleConfirmPwdBtn');
        if (confirmPwd && toggleConfirmBtn) {
            toggleConfirmBtn.addEventListener('click', () => {
                const isPwd = confirmPwd.getAttribute('type') === 'password';
                confirmPwd.setAttribute('type', isPwd ? 'text' : 'password');
            });
        }
    </script>
</body>

</html>
