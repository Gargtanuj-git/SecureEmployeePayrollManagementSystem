@model SecureEmployeePayrollSystem.ViewModels.MfaEnrollViewModel

@{
    Layout = null;
    ViewData["Title"] = "Enroll Two-Factor Authentication - SEPS";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Setup Multi-Factor Authentication - Secure Employee Payroll System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/seps-favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/seps-favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/seps-apple-touch-icon.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <script>
        (function() {
            var savedTheme = localStorage.getItem('seps-theme') || 
                (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <style>
        .enroll-step-badge {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--primary);
            color: var(--primary-text);
            font-size: 13px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .recovery-code-pill {
            font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
            font-size: 13.5px;
            font-weight: 700;
            padding: 6px 12px;
            background: var(--surface-secondary);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            color: var(--text-primary);
            display: inline-block;
        }
        .otp-input-field {
            font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
            font-size: 24px;
            letter-spacing: 6px;
            text-align: center;
            font-weight: 700;
            height: 50px;
            border-radius: 10px;
            border: 2px solid var(--border-color);
            background: var(--surface-bg);
            color: var(--text-primary);
        }
        .otp-input-field:focus {
            outline: none;
            border-color: var(--focus-ring);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
        }
    </style>
</head>

<body>
    <main class="google-login-page" style="padding: 32px 16px; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
        <div style="width: 100%; max-width: 600px; background: var(--surface-bg); border: 1px solid var(--border-color); border-radius: 20px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08); padding: 36px 32px;">

            <!-- THEME TOGGLE -->
            <div style="display: flex; justify-content: flex-end; margin-bottom: 8px;">
                <button type="button" class="theme-toggle-btn" aria-label="Toggle dark/light theme" title="Toggle Theme" style="background: var(--surface-secondary); border: 1px solid var(--border-color); border-radius: 20px; padding: 4px 12px; color: var(--text-primary); display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 11.5px; font-weight: 500;">
                    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" style="width: 14px; height: 14px; fill: currentColor;">
                        <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" />
                    </svg>
                    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" style="width: 14px; height: 14px; fill: currentColor; display: none;">
                        <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z" />
                    </svg>
                    <span class="theme-label-text">Theme</span>
                </button>
            </div>

            <!-- HEADER -->
            <div style="text-align: center; margin-bottom: 28px;">
                <div style="width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35); margin-bottom: 16px;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </div>
                <h1 style="margin: 0 0 6px; font-size: 24px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.02em;">
                    Setup Multi-Factor Authentication
                </h1>
                <p style="font-size: 13.5px; color: var(--text-secondary); margin: 0; line-height: 1.5;">
                    Follow the steps below to connect your authenticator app and safeguard your payroll account.
                </p>
            </div>

            <!-- ALERTS -->
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info" style="margin-bottom: 24px; padding: 12px 16px; font-size: 13px; border-radius: 10px;">
                    <strong>Policy Notice:</strong> @TempData["InfoMessage"]
                </div>
            }

            <form asp-controller="Account" asp-action="EnrollMfa" method="post" id="enrollMfaForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ChallengeToken" />
                <input type="hidden" asp-for="SecretKey" />
                @for (int i = 0; i < Model.RecoveryCodes.Count; i++)
                {
                    <input type="hidden" name="RecoveryCodes[@i]" value="@Model.RecoveryCodes[i]" />
                }

                <div asp-validation-summary="ModelOnly" class="validation-summary" style="margin-bottom: 20px; font-size: 13px; color: #ef4444;"></div>

                <!-- STEP 1: SCAN QR CODE -->
                <div style="background: var(--surface-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; margin-bottom: 20px;">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
                        <span class="enroll-step-badge">1</span>
                        <h2 style="font-size: 15px; font-weight: 700; color: var(--text-primary); margin: 0;">Scan QR Code in Authenticator App</h2>
                    </div>
                    <p style="font-size: 13px; color: var(--text-secondary); margin: 0 0 16px 38px;">
                        Open <strong>Google Authenticator</strong>, <strong>Microsoft Authenticator</strong>, or another TOTP client on your mobile device and scan the QR code below:
                    </p>

                    <div style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
                        <div style="background: #ffffff; padding: 12px; border-radius: 12px; border: 1px solid #cbd5e1; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                            <img src="@Model.QrCodeDataUri" alt="Authenticator QR Code" style="width: 170px; height: 170px; display: block;" />
                        </div>
                        <div style="text-align: center;">
                            <span style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 4px;">Can't scan? Enter this secret key manually:</span>
                            <div style="display: inline-flex; align-items: center; gap: 8px; background: var(--surface-bg); border: 1px solid var(--border-color); padding: 4px 10px; border-radius: 6px;">
                                <code id="manualSecretKey" style="font-size: 12.5px; font-weight: 700; color: var(--primary); letter-spacing: 1px;">@Model.ManualEntryKey</code>
                                <button type="button" onclick="copySecretKey()" style="background: none; border: none; cursor: pointer; color: var(--text-secondary); padding: 2px;" title="Copy key">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 2: EMERGENCY RECOVERY CODES -->
                <div style="background: var(--surface-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; margin-bottom: 20px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span class="enroll-step-badge">2</span>
                            <h2 style="font-size: 15px; font-weight: 700; color: var(--text-primary); margin: 0;">Save Emergency Recovery Codes</h2>
                        </div>
                        <button type="button" onclick="copyRecoveryCodes()" class="btn btn-outline" style="font-size: 11.5px; padding: 4px 10px; height: auto;">
                            Copy All
                        </button>
                    </div>
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0 0 12px 38px;">
                        Save these single-use codes in a secure location. You can use them to recover access if you lose your authenticator device:
                    </p>
                    <div style="margin-left: 38px; display: flex; flex-wrap: wrap; gap: 8px;" id="recoveryCodesContainer">
                        @foreach (var code in Model.RecoveryCodes)
                        {
                            <span class="recovery-code-pill">@code</span>
                        }
                    </div>
                </div>

                <!-- STEP 3: LIVE VERIFICATION -->
                <div style="background: var(--surface-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; margin-bottom: 24px;">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                        <span class="enroll-step-badge">3</span>
                        <h2 style="font-size: 15px; font-weight: 700; color: var(--text-primary); margin: 0;">Verify & Activate Authenticator</h2>
                    </div>
                    <p style="font-size: 12.5px; color: var(--text-secondary); margin: 0 0 14px 38px;">
                        Enter the 6-digit code currently shown in your authenticator app to test synchronization:
                    </p>
                    <div style="margin-left: 38px; max-width: 240px;">
                        <input asp-for="VerificationCode" class="otp-input-field form-control" maxlength="6" autocomplete="off" placeholder="000000" autofocus />
                        <span asp-validation-for="VerificationCode" class="text-danger" style="font-size: 12px; display: block; margin-top: 6px;"></span>
                    </div>
                </div>

                <!-- SUBMIT BUTTON -->
                <button type="submit" class="btn btn-primary" style="width: 100%; height: 46px; font-size: 15px; font-weight: 700; border-radius: 10px; display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Confirm & Activate MFA
                </button>
            </form>

            <!-- FOOTER -->
            <div style="margin-top: 20px; text-align: center; border-top: 1px solid var(--border-color); padding-top: 14px;">
                <a asp-controller="Account" asp-action="Login" style="font-size: 13px; color: var(--text-secondary); text-decoration: none; font-weight: 500;">
                    Cancel & Return to Login
                </a>
            </div>

        </div>
    </main>

    <script>
        function copySecretKey() {
            var key = document.getElementById('manualSecretKey').innerText;
            navigator.clipboard.writeText(key).then(function() {
                alert('Secret key copied to clipboard: ' + key);
            });
        }

        function copyRecoveryCodes() {
            var codes = [];
            document.querySelectorAll('.recovery-code-pill').forEach(function(pill) {
                codes.push(pill.innerText.trim());
            });
            var allCodes = codes.join('\n');
            navigator.clipboard.writeText(allCodes).then(function() {
                alert('All emergency recovery codes copied to clipboard!\n\nSave them in a safe place.');
            });
        }
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
