@model SecureEmployeePayrollSystem.ViewModels.ForgotPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Account Recovery - Secure Employee Payroll System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account Recovery - Secure Employee Payroll System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/seps-favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/seps-favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/seps-apple-touch-icon.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <script>
        (function() {
            var savedTheme = localStorage.getItem('seps-theme') || 
                (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body>
    <main class="google-login-page" style="padding: 24px 16px;">
        <section class="login-card" style="max-width: 480px; width: 100%; border-radius: 20px; box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12); padding: 36px 32px;">

            <!-- THEME TOGGLE -->
            <div style="display: flex; justify-content: flex-end; margin-bottom: 8px;">
                <button type="button" class="theme-toggle-btn" aria-label="Toggle dark/light theme" title="Toggle Theme" style="background: var(--surface-secondary); border: 1px solid var(--border-color); border-radius: 20px; padding: 4px 12px; color: var(--text-primary); display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 11.5px; font-weight: 500;">
                    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" style="width: 14px; height: 14px; fill: currentColor;">
                        <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" />
                    </svg>
                    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" style="width: 14px; height: 14px; fill: currentColor; display: none;">
                        <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z" />
                    </svg>
                    <span class="theme-label-text">Theme</span>
                </button>
            </div>

            <div style="margin-bottom: 24px; text-align: center;">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35); margin: 0 auto 12px;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </div>
                <div style="display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 6px;">
                    <span style="font-size: 22px; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary);">SEPS</span>
                    <span style="background: rgba(16, 185, 129, 0.15); color: var(--success); font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 12px; border: 1px solid rgba(16, 185, 129, 0.3);">v2.5</span>
                </div>
                <h1 style="margin: 8px 0 4px; font-size: 20px; font-weight: 700; color: var(--text-primary);">Account Recovery</h1>
                <p style="font-size: 13px; color: var(--text-secondary); margin: 0;">Recover access to your enterprise payroll account</p>
            </div>

            @if (ViewBag.Message != null)
            {
                <div style="background-color: var(--info-bg); color: var(--info); padding: 16px; border-radius: 10px; margin-bottom: 24px; font-size: 13px; line-height: 1.5; border: 1px solid var(--border-color);">
                    <strong>Request Received</strong><br />
                    @ViewBag.Message
                    <br /><br />
                    <small style="color: var(--text-muted);">@ViewBag.DemoNote</small>
                </div>

                <div style="text-align: center;">
                    <a asp-action="Login" class="btn btn-primary" style="display: block; width: 100%; height: 42px; line-height: 42px; text-align: center; text-decoration: none; border-radius: 10px; font-weight: 600;">
                        Return to Sign In
                    </a>
                </div>
            }
            else
            {
                <form asp-controller="Account" asp-action="ForgotPassword" method="post" autocomplete="on">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary" style="margin-bottom: 16px;"></div>

                    <div style="margin-bottom: 20px;">
                        <label asp-for="UsernameOrEmail" style="display: block; font-size: 13px; font-weight: 500; color: var(--text-secondary); margin-bottom: 6px;">
                            Username or Registered Work Email
                        </label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex; align-items: center; pointer-events: none;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                            </span>
                            <input asp-for="UsernameOrEmail" class="form-control" placeholder="Enter username or work email" required autofocus style="padding-left: 42px; height: 44px; border-radius: 10px;" />
                        </div>
                        <span asp-validation-for="UsernameOrEmail" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <button type="submit" style="width: 100%; height: 44px; border-radius: 10px; border: none; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #ffffff; font-size: 14px; font-weight: 600; cursor: pointer; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35); margin-bottom: 16px;">
                        Send Recovery Link
                    </button>

                    <div style="text-align: center;">
                        <a asp-action="Login" style="color: var(--link-color); text-decoration: none; font-size: 13px; font-weight: 500;">
                            ← Back to Sign In
                        </a>
                    </div>
                </form>
            }

            <div style="display: flex; align-items: flex-start; gap: 8px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--divider-color); font-size: 11.5px; color: var(--text-muted); line-height: 1.4;">
                <span style="font-size: 14px;">🔒</span>
                <span>To protect sensitive payroll records, recovery notifications are sanitized to prevent username enumeration.</span>
            </div>
        </section>
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
