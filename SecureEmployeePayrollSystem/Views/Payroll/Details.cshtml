@model SecureEmployeePayrollSystem.Models.Payroll

@{
    ViewData["Title"] = $"Payroll #{Model.PayrollId} - {Model.Employee?.FirstName} {Model.Employee?.LastName}";
    bool canManage = User.IsInRole("Admin") || User.IsInRole("Payroll Manager");
    decimal net = Model.NetSalary ?? (Model.GrossSalary - Model.TotalDeductions);
}

<div class="page-header">
    <div>
        <h1>Payroll Record #@Model.PayrollId</h1>
        <p>Employee: @Model.Employee?.FirstName @Model.Employee?.LastName (#@Model.EmployeeId) | Period: @Model.PayPeriodStart.ToString("dd MMM yyyy") to @Model.PayPeriodEnd.ToString("dd MMM yyyy")</p>
    </div>
    <div class="page-header-actions" style="display: flex; gap: 8px;">
        <a asp-controller="Payroll" asp-action="Index" class="btn btn-secondary">
            &larr; Payroll Log
        </a>
        <a asp-controller="Payroll" asp-action="Payslip" asp-route-id="@Model.PayrollId" class="btn btn-primary">
            🖨️ View & Print Payslip
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<!-- KEY METRIC CARDS -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px;">
    <div class="content-card" style="padding: 20px;">
        <div style="font-size: 12px; color: var(--seps-text-secondary); text-transform: uppercase;">Gross Earnings</div>
        <div style="font-size: 24px; font-weight: 700; color: var(--seps-text);">₹@Model.GrossSalary.ToString("N2")</div>
    </div>

    <div class="content-card" style="padding: 20px;">
        <div style="font-size: 12px; color: var(--seps-text-secondary); text-transform: uppercase;">Total Deductions</div>
        <div style="font-size: 24px; font-weight: 700; color: var(--google-red);">₹@Model.TotalDeductions.ToString("N2")</div>
    </div>

    <div class="content-card" style="padding: 20px;">
        <div style="font-size: 12px; color: var(--seps-text-secondary); text-transform: uppercase;">Net Take-Home Pay</div>
        <div style="font-size: 24px; font-weight: 700; color: var(--google-green);">₹@net.ToString("N2")</div>
    </div>

    <div class="content-card" style="padding: 20px;">
        <div style="font-size: 12px; color: var(--seps-text-secondary); text-transform: uppercase;">Disbursement Status</div>
        <div style="font-size: 20px; font-weight: 600; margin-top: 4px;">
            @if (Model.PayrollStatus == "Paid")
            {
                <span class="status-badge status-success">Paid</span>
            }
            else if (Model.PayrollStatus == "Processed")
            {
                <span class="status-badge status-info">Processed</span>
            }
            else
            {
                <span class="status-badge status-warning">@Model.PayrollStatus</span>
            }
        </div>
    </div>
</div>

<!-- PAYROLL PARTICULARS BREAKDOWN -->
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">

    <!-- EARNINGS BREAKDOWN -->
    <div class="content-card">
        <div class="card-header" style="padding: 16px 20px; border-bottom: 1px solid var(--seps-border);">
            <h2 style="font-size: 15px; font-weight: 600; margin: 0; color: var(--google-green);">Earnings Components</h2>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Item Description</th>
                        <th style="text-align: right;">Amount (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var earnings = Model.PayrollItems.Where(i => i.ItemType == "Earning").ToList();
                    }
                    @if (earnings.Any())
                    {
                        int index = 1;
                        foreach (var e in earnings)
                        {
                            <tr>
                                <td>@(index == 1 ? "Basic Salary" : $"Allowance / Component #{index - 1}")</td>
                                <td style="text-align: right;"><strong>₹@((e.CalculationBasis ?? 0).ToString("N2"))</strong></td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td>Basic Salary</td>
                            <td style="text-align: right;"><strong>₹@Model.GrossSalary.ToString("N2")</strong></td>
                        </tr>
                    }
                    <tr style="background: var(--seps-surface-variant, var(--surface-secondary)); font-weight: 600;">
                        <td>Total Gross Salary</td>
                        <td style="text-align: right; color: var(--google-green);">₹@Model.GrossSalary.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- DEDUCTIONS BREAKDOWN -->
    <div class="content-card">
        <div class="card-header" style="padding: 16px 20px; border-bottom: 1px solid var(--seps-border);">
            <h2 style="font-size: 15px; font-weight: 600; margin: 0; color: var(--google-red);">Deductions Components</h2>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Item Description</th>
                        <th style="text-align: right;">Amount (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var deductions = Model.PayrollItems.Where(i => i.ItemType == "Deduction").ToList();
                    }
                    @if (deductions.Any())
                    {
                        int dIndex = 1;
                        foreach (var d in deductions)
                        {
                            <tr>
                                <td>Deduction Component #@dIndex</td>
                                <td style="text-align: right;"><strong>₹@((d.CalculationBasis ?? 0).ToString("N2"))</strong></td>
                            </tr>
                            dIndex++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" style="text-align: center; color: var(--seps-text-secondary); padding: 16px;">
                                No deductions applied to this pay period.
                            </td>
                        </tr>
                    }
                    <tr style="background: var(--seps-surface-variant, var(--surface-secondary)); font-weight: 600;">
                        <td>Total Deductions</td>
                        <td style="text-align: right; color: var(--google-red);">₹@Model.TotalDeductions.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- ADMINISTRATIVE STATUS MANAGEMENT -->
@if (canManage)
{
    <div class="content-card" style="margin-bottom: 24px;">
        <div class="card-header" style="padding: 16px 20px; border-bottom: 1px solid var(--seps-border);">
            <h2 style="font-size: 15px; font-weight: 600; margin: 0;">Disbursement Status Management</h2>
        </div>
        <div style="padding: 20px; display: flex; gap: 12px; align-items: center;">
            <span style="font-size: 14px; color: var(--seps-text-secondary);">Update record status:</span>
            
            <form asp-controller="Payroll" asp-action="UpdateStatus" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.PayrollId" />
                <input type="hidden" name="newStatus" value="Paid" />
                <button type="submit" class="btn btn-primary btn-sm" disabled="@(Model.PayrollStatus == "Paid" ? "disabled" : null)">
                    Mark as Paid
                </button>
            </form>

            <form asp-controller="Payroll" asp-action="UpdateStatus" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.PayrollId" />
                <input type="hidden" name="newStatus" value="Processed" />
                <button type="submit" class="btn btn-secondary btn-sm" disabled="@(Model.PayrollStatus == "Processed" ? "disabled" : null)">
                    Mark as Processed
                </button>
            </form>

            <form asp-controller="Payroll" asp-action="UpdateStatus" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.PayrollId" />
                <input type="hidden" name="newStatus" value="Pending" />
                <button type="submit" class="btn btn-secondary btn-sm" disabled="@(Model.PayrollStatus == "Pending" ? "disabled" : null)">
                    Mark as Pending
                </button>
            </form>
        </div>
    </div>
}
