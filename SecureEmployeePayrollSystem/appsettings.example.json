{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=SecureEmployeePayrollDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Authentication": {
    "FailedLoginThreshold": 5,
    "LockoutDurationSeconds": 30
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Username": "your-email@example.com",
    "Password": "your-app-password",
    "EnableSsl": "true",
    "FromAddress": "no-reply@seps-payroll.internal",
    "FromName": "SEPS Security"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
